<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="48" width="48" />
    <div class="header-fields">
      <input class="char-name flex-grow" name="name" type="text" value="{{item.name}}" />
      <span class="stat-label" style="text-transform:uppercase;">feat</span>
    </div>
  </header>
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description"><i class="fas fa-book"></i> Description</a>
    <a class="item" data-tab="details"><i class="fas fa-cog"></i> Details</a>
  </nav>
  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="description">
      <h3>Description</h3>
      {{editor enrichedDescription target="system.description" button=true editable=editable}}
    </div>
    <div class="tab" data-group="primary" data-tab="details">
      <div class="form-group">
        <label>Feat type</label>
        <input type="text" name="system.featType" value="{{system.featType}}" placeholder="General, Fighter, Metamagic" />
      </div>
      <div class="form-group">
        <label>Prerequisites</label>
        <input type="text" name="system.prerequisites" value="{{system.prerequisites}}" />
      </div>
      <div class="form-group">
        <label>Choice</label>
        <input type="text" name="system.selection" value="{{system.selection}}" placeholder="longsword, evocation" />
      </div>
      <p class="notes">Improved Initiative, Dodge, Great Fortitude, Lightning Reflexes, Iron Will, Toughness, Combat Casting, Weapon Finesse, Power Attack, Combat Expertise, Two-Weapon Fighting, Combat Reflexes, Rapid Shot, and Spell Penetration apply on their own. Weapon Focus, Weapon Specialization, and Spell Focus need a Choice (or the weapon or school in parentheses on the feat name).</p>
    </div>
  </section>
</form>
