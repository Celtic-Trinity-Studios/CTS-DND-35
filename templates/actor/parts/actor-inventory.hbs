{{!-- Inventory Tab Partial --}}
<h3>Weapons</h3>
<ol class="item-list mb-md">
  {{#each items.weapons}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><div class="item-controls"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>
<a class="item-create cts-btn secondary mb-lg" data-type="weapon"><i class="fas fa-plus"></i> Add Weapon</a>

<h3>Armor &amp; Shields</h3>
<ol class="item-list mb-md">
  {{#each items.armor}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><div class="item-controls"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>
<a class="item-create cts-btn secondary mb-lg" data-type="armor"><i class="fas fa-plus"></i> Add Armor</a>

<h3>Equipment</h3>
<ol class="item-list mb-md">
  {{#each items.equipment}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><span style="width:40px;">x{{this.system.quantity}}</span><div class="item-controls"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>
<a class="item-create cts-btn secondary mb-lg" data-type="equipment"><i class="fas fa-plus"></i> Add Equipment</a>

<h3>Consumables</h3>
<ol class="item-list mb-md">
  {{#each items.consumables}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><span style="width:40px;">x{{this.system.quantity}}</span><div class="item-controls"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>
<a class="item-create cts-btn secondary" data-type="consumable"><i class="fas fa-plus"></i> Add Consumable</a>

{{!-- Currency --}}
<h3 class="mb-sm" style="margin-top:12px;">Currency</h3>
<div class="combat-stats">
  <div class="stat-box"><div class="stat-label">CP</div><input type="number" name="system.currency.cp" value="{{system.currency.cp}}" /></div>
  <div class="stat-box"><div class="stat-label">SP</div><input type="number" name="system.currency.sp" value="{{system.currency.sp}}" /></div>
  <div class="stat-box"><div class="stat-label">GP</div><input type="number" name="system.currency.gp" value="{{system.currency.gp}}" /></div>
  <div class="stat-box"><div class="stat-label">PP</div><input type="number" name="system.currency.pp" value="{{system.currency.pp}}" /></div>
</div>
