{{!-- Features Tab Partial --}}
<h3>Classes</h3>
<ol class="item-list mb-md">
  <li class="item-header"><span class="flex-grow">Class</span><span style="width:50px;text-align:center;">Lvl</span><span style="width:50px;text-align:center;">HD</span><span style="width:60px;">Ctrl</span></li>
  {{#each items.classes}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><span style="width:50px;text-align:center;">{{this.system.level}}</span><span style="width:50px;text-align:center;">{{this.system.hitDie}}</span><div class="item-controls" style="width:60px;"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>

<h3>Feats</h3>
<ol class="item-list mb-md">
  <li class="item-header"><span class="flex-grow">Feat</span><span style="width:80px;">Type</span><span style="width:60px;">Ctrl</span></li>
  {{#each items.feats}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><span style="width:80px;">{{this.system.featType}}</span><div class="item-controls" style="width:60px;"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>

<h3>Features</h3>
<ol class="item-list mb-md">
  <li class="item-header"><span class="flex-grow">Feature</span><span style="width:80px;">Source</span><span style="width:60px;">Ctrl</span></li>
  {{#each items.features}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><span style="width:80px;">{{this.system.classSource}}</span><div class="item-controls" style="width:60px;"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>

<h3>Buffs</h3>
<ol class="item-list mb-md">
  {{#each items.buffs}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><span style="width:60px;">{{#if this.system.active}}✓{{else}}—{{/if}}</span><div class="item-controls" style="width:60px;"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>
