<section class="cts-panel-block cts-identity">
  <h3><i class="fas fa-id-card"></i> Identity, languages &amp; type</h3>
  <div class="cts-identity-grid">
    <label>Age <input type="text" name="system.details.age" value="{{system.details.age}}" placeholder="e.g. 22 years" /></label>
    <label>Height <input type="text" name="system.details.height" value="{{system.details.height}}" /></label>
    <label>Weight <input type="text" name="system.details.weight" value="{{system.details.weight}}" /></label>
    <label>Eyes <input type="text" name="system.details.eyes" value="{{system.details.eyes}}" /></label>
    <label>Hair <input type="text" name="system.details.hair" value="{{system.details.hair}}" /></label>
  </div>
  <label class="cts-full-width">Languages<br />
    <textarea name="system.details.languages" rows="2" placeholder="Common, Elven, Draconic…">{{system.details.languages}}</textarea>
  </label>
  <label class="cts-inline-checkbox">Literate
    <select name="system.details.literate">
      <option value="true" {{#if system.details.literate}}selected{{/if}}>Yes</option>
      <option value="false" {{#unless system.details.literate}}selected{{/unless}}>No</option>
    </select>
  </label>

  <h4>Multiclass &amp; XP (PHB)</h4>
  <div class="cts-identity-grid">
    <label>Favored class (player choice) <input type="text" name="system.details.favoredClass" value="{{system.details.favoredClass}}" placeholder="Class name" /></label>
    <label>Racial favored class <input type="text" name="system.details.racialFavoredClass" value="{{system.details.racialFavoredClass}}" /></label>
    <label>LA buyoff XP spent <input type="number" name="system.details.laBuyoffXp" value="{{system.details.laBuyoffXp}}" min="0" step="1" title="Track XP spent to reduce level adjustment" /></label>
  </div>
  <p class="cts-hint-block">Next level at {{system.details.level.xpNext}} XP.</p>
  {{#if system.details.xpMulticlassHint}}
  <p class="cts-hint-block">{{system.details.xpMulticlassHint}}</p>
  {{/if}}
  {{#if system.spellcasting.powerPoints}}
  <p class="cts-hint-block">Suggested power points: {{system.spellcasting.powerPoints}} (class table plus half the key ability modifier times manifester level). Left: {{system.spellcasting.powerPointsCurrent}}.</p>
  {{/if}}
  {{#if system.attributes.classFeatures.length}}
  <h4>Class features on the class items</h4>
  <ul>
    {{#each system.attributes.classFeatures}}
    <li>{{className}} {{level}}: {{name}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if system.attributes.slots.overflow.length}}
  <h4>Body slots over the cap</h4>
  <ul>
    {{#each system.attributes.slots.overflow}}
    <li>{{slot}}: {{count}} equipped, cap {{cap}}</li>
    {{/each}}
  </ul>
  {{/if}}

  <h4>Optional ability tables</h4>
  <p class="cts-hint-block">Leave these off when ability scores already include race or age. Turning them on adds the PHB race row or the middle / old / venerable table on top of the written scores.</p>
  <div class="cts-identity-grid">
    <label>Age category
      <select name="system.details.ageCategory">
        <option value="" {{#unless system.details.ageCategory}}selected{{/unless}}>None</option>
        <option value="middle" {{#if (cts-eq system.details.ageCategory "middle")}}selected{{/if}}>Middle</option>
        <option value="old" {{#if (cts-eq system.details.ageCategory "old")}}selected{{/if}}>Old</option>
        <option value="venerable" {{#if (cts-eq system.details.ageCategory "venerable")}}selected{{/if}}>Venerable</option>
      </select>
    </label>
    <label>Apply aging table
      <select name="system.traits.applyAgingTable">
        <option value="false" {{#unless system.traits.applyAgingTable}}selected{{/unless}}>No</option>
        <option value="true" {{#if system.traits.applyAgingTable}}selected{{/if}}>Yes</option>
      </select>
    </label>
    <label>Fractional BAB and saves
      <select name="system.details.fractional" title="Unearthed Arcana: high BAB equals level, medium is three-quarters, low is half.">
        <option value="false" {{#unless system.details.fractional}}selected{{/unless}}>Standard tables</option>
        <option value="true" {{#if system.details.fractional}}selected{{/if}}>Fractional</option>
      </select>
    </label>
    <label>Combine spell slots
      <select name="system.details.combineSlots">
        <option value="false" {{#unless system.details.combineSlots}}selected{{/unless}}>Separate</option>
        <option value="true" {{#if system.details.combineSlots}}selected{{/if}}>Add slots together</option>
      </select>
    </label>
    <label>Skill tricks <input type="text" name="system.details.skillTricks" value="{{system.details.skillTricks}}" placeholder="jmp, tumble" title="Skill keys or names. Each listed skill is +2." /></label>
    <label>Region <input type="text" name="system.details.region" value="{{system.details.region}}" /></label>
    <label>Reputation <input type="number" name="system.details.reputation" value="{{system.details.reputation}}" step="1" /></label>
    <label>Rebuild log <input type="text" name="system.details.rebuildLog" value="{{system.details.rebuildLog}}" placeholder="Replaced level 4 fighter with barbarian" /></label>
    <label>Gestalt
      <select name="system.details.gestalt">
        <option value="false" {{#unless system.details.gestalt}}selected{{/unless}}>No</option>
        <option value="true" {{#if system.details.gestalt}}selected{{/if}}>Best BAB and saves</option>
      </select>
    </label>
    <label>Racial HD <input type="number" name="system.details.racialHd" value="{{system.details.racialHd}}" min="0" step="1" /></label>
    <label>Racial BAB
      <select name="system.details.racialBab">
        <option value="med" {{#unless (cts-eq system.details.racialBab "high")}}{{#unless (cts-eq system.details.racialBab "low")}}selected{{/unless}}{{/unless}}>Medium</option>
        <option value="high" {{#if (cts-eq system.details.racialBab "high")}}selected{{/if}}>High</option>
        <option value="low" {{#if (cts-eq system.details.racialBab "low")}}selected{{/if}}>Low</option>
      </select>
    </label>
    <label>Linked companion <input type="text" name="system.details.companionId" value="{{system.details.companionId}}" placeholder="Actor id" /></label>
    <label>Forbidden schools <input type="text" name="system.spellcasting.forbiddenSchools" value="{{system.spellcasting.forbiddenSchools}}" placeholder="Enchantment, Evocation" /></label>
    <label>Power points left <input type="number" name="system.spellcasting.powerPointsCurrent" value="{{system.spellcasting.powerPointsCurrent}}" min="0" step="1" /></label>
    <label>Fortification % <input type="number" name="system.attributes.fortification" value="{{system.attributes.fortification}}" min="0" max="100" step="1" /></label>
    <label>Apply racial adjustments
      <select name="system.traits.applyRacialAdjustments">
        <option value="false" {{#unless system.traits.applyRacialAdjustments}}selected{{/unless}}>No</option>
        <option value="true" {{#if system.traits.applyRacialAdjustments}}selected{{/if}}>Yes, from the Race name</option>
      </select>
    </label>
  </div>

  <h4>Creature type (character)</h4>
  <div class="cts-identity-grid">
    <label>Type <input type="text" name="system.details.creatureType" value="{{system.details.creatureType}}" placeholder="e.g. Humanoid" /></label>
    <label>Subtype <input type="text" name="system.details.creatureSubtype" value="{{system.details.creatureSubtype}}" placeholder="e.g. Elf" /></label>
    <label>Humanoid subtype <input type="text" name="system.details.humanoidSubtype" value="{{system.details.humanoidSubtype}}" placeholder="If humanoid" /></label>
  </div>

  <h4>Senses</h4>
  <p class="cts-hint-block">Darkvision, low-light, and blindsight update the token. Scene light (the Light tool, or the scene’s Environment tab) decides whether that vision can see.</p>
  <div class="cts-identity-grid">
    <label>Darkvision (ft) <input type="number" name="system.traits.senses.darkvision" value="{{system.traits.senses.darkvision}}" min="0" step="5" /></label>
    <label class="cts-inline-checkbox">Low-light
      <select name="system.traits.senses.lowLightVision">
        <option value="false" {{#unless system.traits.senses.lowLightVision}}selected{{/unless}}>No</option>
        <option value="true" {{#if system.traits.senses.lowLightVision}}selected{{/if}}>Yes</option>
      </select>
    </label>
    <label>Blindsense (ft) <input type="number" name="system.traits.senses.blindsense" value="{{system.traits.senses.blindsense}}" min="0" step="5" /></label>
    <label>Blindsight (ft) <input type="number" name="system.traits.senses.blindsight" value="{{system.traits.senses.blindsight}}" min="0" step="5" /></label>
    <label>Tremorsense (ft) <input type="number" name="system.traits.senses.tremorsense" value="{{system.traits.senses.tremorsense}}" min="0" step="5" /></label>
    <label class="cts-inline-checkbox">Scent
      <select name="system.traits.senses.scent">
        <option value="false" {{#unless system.traits.senses.scent}}selected{{/unless}}>No</option>
        <option value="true" {{#if system.traits.senses.scent}}selected{{/if}}>Yes</option>
      </select>
    </label>
  </div>
  <label class="cts-full-width">Sense notes<br />
    <input type="text" name="system.traits.senses.notes" value="{{system.traits.senses.notes}}" class="flex-grow" placeholder="See in darkness, etc." />
  </label>

  <h4>Polymorph / wild shape (physical stats)</h4>
  <p class="cts-hint-block">When enabled, <strong>Str / Dex / Con</strong> modifiers use the scores below instead of the normal ability fields (still apply damage/drain/aging to those polymorph scores).</p>
  <label class="cts-inline-checkbox">Replace physical scores
    <select name="system.traits.polymorph.enabled">
      <option value="false" {{#unless system.traits.polymorph.enabled}}selected{{/unless}}>No</option>
      <option value="true" {{#if system.traits.polymorph.enabled}}selected{{/if}}>Yes (polymorph / wild shape)</option>
    </select>
  </label>
  <div class="cts-identity-grid">
    <label>Polymorph STR <input type="number" name="system.traits.polymorph.str" value="{{system.traits.polymorph.str}}" min="1" max="99" /></label>
    <label>Polymorph DEX <input type="number" name="system.traits.polymorph.dex" value="{{system.traits.polymorph.dex}}" min="1" max="99" /></label>
    <label>Polymorph CON <input type="number" name="system.traits.polymorph.con" value="{{system.traits.polymorph.con}}" min="1" max="99" /></label>
  </div>
  <label class="cts-full-width">Polymorph notes <input type="text" name="system.traits.polymorph.notes" value="{{system.traits.polymorph.notes}}" /></label>
</section>
