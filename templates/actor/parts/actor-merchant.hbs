{{!-- NPC merchant (shop) controls — stock lives on this actor's Inventory tab --}}
<div class="cts-merchant-block">
  <h3><i class="fas fa-store"></i> {{localize "CTSDND35.MerchantShop"}}</h3>
  <div class="cts-line">
    <label class="cts-checkbox-label">
      <input type="checkbox" name="system.merchant.enabled" {{#if system.merchant.enabled}}checked{{/if}} />
      {{localize "CTSDND35.MerchantEnable"}}
    </label>
  </div>
  <div class="cts-line">
    <label class="cts-checkbox-label">
      <input type="checkbox" name="system.merchant.purchaseOnly" {{#if system.merchant.purchaseOnly}}checked{{/if}} />
      {{localize "CTSDND35.MerchantPurchaseOnly"}}
    </label>
  </div>
  <div class="flex-row" style="gap:12px; flex-wrap:wrap; align-items:center;">
    <label>{{localize "CTSDND35.MerchantBuyMultiplier"}}
      <input type="number" step="0.05" min="0" name="system.merchant.buyMultiplier" value="{{system.merchant.buyMultiplier}}" style="width:72px;" />
    </label>
    <label>{{localize "CTSDND35.MerchantSellMultiplier"}}
      <input type="number" step="0.05" min="0" name="system.merchant.sellMultiplier" value="{{system.merchant.sellMultiplier}}" style="width:72px;" />
    </label>
  </div>
  <p class="cts-hint-block">{{localize "CTSDND35.MerchantHint"}}</p>
  <div class="cts-line" style="margin-top:8px;">
    <button type="button" class="cts-open-merchant-shop">
      <i class="fas fa-shopping-basket"></i> {{localize "CTSDND35.MerchantOpenShop"}}
    </button>
  </div>
</div>
