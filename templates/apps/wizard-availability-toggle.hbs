<div class="wizard-availability-toggle" role="group" aria-label="Which choices to list">
  <button type="button" class="set-availability-view{{#if showUnavailableOptions}} active{{/if}}" data-show-unavailable="true" title="List every choice, including ones you do not qualify for">Show All</button>
  <button type="button" class="set-availability-view{{#unless showUnavailableOptions}} active{{/unless}}" data-show-unavailable="false" title="List only choices you qualify for">Available</button>
</div>
