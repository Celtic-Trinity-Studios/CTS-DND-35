{{!-- Combat Stats Partial --}}

{{!-- HP --}}
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">HP</div>
    <div class="hp-bar">
      <input type="number" name="system.attributes.hp.value" value="{{system.attributes.hp.value}}" />
      <span class="hp-sep">/</span>
      <input type="number" name="system.attributes.hp.max" value="{{system.attributes.hp.max}}" />
    </div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Temp HP</div>
    <input type="number" name="system.attributes.hp.temp" value="{{system.attributes.hp.temp}}" title="Manual temp HP total" />
  </div>
  <div class="stat-box">
    <div class="stat-label">Temp (tracked)</div>
    <span class="stat-value derived" title="Sum of sources below">{{system.attributes.hp.tempSourcesSum}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">Nonlethal</div>
    <input type="number" name="system.attributes.hp.nonlethal" value="{{system.attributes.hp.nonlethal}}" />
  </div>
  <div class="stat-box">
    <div class="stat-label">Neg. levels</div>
    <input type="number" name="system.attributes.negativeLevels" value="{{system.attributes.negativeLevels}}" min="0" step="1" title="−1 saves/skills/init/grapple per level (SRD)" />
  </div>
</div>

<div class="cts-temp-hp-sources mb-md">
  <span class="stat-label">Temp HP sources</span>
  {{#each system.attributes.hp.tempSources}}
  <div class="flexrow cts-temp-hp-row" data-index="{{@index}}">
    <input type="text" name="system.attributes.hp.tempSources.{{@index}}.label" value="{{this.label}}" placeholder="Source" class="flex-grow" />
    <input type="number" name="system.attributes.hp.tempSources.{{@index}}.amount" value="{{this.amount}}" min="0" step="1" style="width:56px;" />
    <button type="button" class="cts-icon-btn cts-remove-temp-hp" data-index="{{@index}}" title="Remove"><i class="fas fa-trash"></i></button>
  </div>
  {{else}}
  <p class="notes">No rows — add one for rage, aid, etc.</p>
  {{/each}}
  <button type="button" class="cts-btn secondary cts-add-temp-hp"><i class="fas fa-plus"></i> Add temp HP source</button>
</div>

{{!-- AC — computed, read-only display --}}
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">AC</div>
    <div class="stat-value derived">{{system.attributes.ac.normal}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Touch</div>
    <div class="stat-value derived">{{system.attributes.ac.touch}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Flat-Footed</div>
    <div class="stat-value derived">{{system.attributes.ac.flatFooted}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Natural</div>
    <input type="number" name="system.attributes.ac.naturalArmor" value="{{system.attributes.ac.naturalArmor}}" title="Natural Armor (manual override)" />
  </div>
  {{#if system.attributes.ac.effectiveMaxDex}}
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncMaxDexCap"}}</div>
    <span class="stat-value derived">{{system.attributes.ac.effectiveMaxDex}}</span>
  </div>
  {{/if}}
</div>

<div class="combat-stats mb-md cts-encumbrance-summary" title="Carrying capacity vs armor (world setting encumbrance automation)">
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncCarriedWeight"}}</div>
    <span class="stat-value derived">{{system.attributes.encumbrance.weightLb}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncLoadBand"}}</div>
    <span class="stat-value derived">{{system.attributes.encumbrance.weightBand}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncSpeedTier"}}</div>
    <span class="stat-value derived">{{system.attributes.encumbrance.speedTier}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncEffectiveACP"}}</div>
    <span class="stat-value derived">−{{system.attributes.encumbrance.effectiveCheckPenaltyMag}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncASF"}}</div>
    <span class="stat-value derived">{{system.spellcasting.arcaneSpellFailureTotal}}%</span>
  </div>
</div>

{{!-- BAB / Grapple / Init / SR --}}
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">BAB</div>
    <div class="stat-value derived" title="Negative levels apply −1 per level on attacks">{{cts-sign system.attributes.bab.total}}{{#if system.attributes.bab.attackPenalty}} <small>(−{{system.attributes.bab.attackPenalty}} atk)</small>{{/if}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Grapple</div>
    <div class="stat-value derived">{{cts-sign system.attributes.grapple.total}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Init</div>
    <div class="stat-value derived rollable init-roll" title="Roll Initiative">
      {{cts-sign system.attributes.init.total}}
    </div>
  </div>
  <div class="stat-box">
    <div class="stat-label">SR</div>
    <input type="number" name="system.attributes.sr.value" value="{{system.attributes.sr.value}}" />
  </div>
</div>

{{!-- Saving Throws --}}
<div class="saving-throws mb-md">
  {{#each system.attributes.savingThrows as |save key|}}
  <div class="save">
    <span class="save-label">{{key}}</span>
    <span class="save-total rollable save-roll" data-save="{{key}}" title="Roll {{key}} save">
      {{cts-sign save.total}}
    </span>
    <input type="number" name="system.attributes.savingThrows.{{key}}.base" value="{{save.base}}" style="width:36px;text-align:center;" title="Base Save" />
    <input type="number" name="system.attributes.savingThrows.{{key}}.bonus" value="{{save.bonus}}" style="width:36px;text-align:center;" title="Misc Bonus" />
  </div>
  {{/each}}
</div>

{{!-- Speed --}}
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">Land base</div>
    <input type="number" name="system.attributes.speed.land.base" value="{{system.attributes.speed.land.base}}" /> ft
  </div>
  <div class="stat-box">
    <div class="stat-label">Land total</div>
    <span class="stat-value derived" title="After armor speed penalty, encumbrance, difficult terrain">{{system.attributes.speed.land.total}} ft</span>
  </div>
  {{#if system.attributes.speed.land.armorPenaltyFt}}
  <div class="stat-box">
    <div class="stat-label">Armor spd −</div>
    <span class="stat-value derived">{{system.attributes.speed.land.armorPenaltyFt}} ft</span>
  </div>
  {{/if}}
  <div class="stat-box">
    <div class="stat-label">Reach</div>
    <span class="stat-value derived" title="Default by size; override on Identity if needed">{{system.traits.reachFt}} ft</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">Reach ovrd</div>
    <input type="number" name="system.traits.reachOverride" value="{{system.traits.reachOverride}}" placeholder="auto" title="Blank = size default" style="width:52px;" /> ft
  </div>
  <div class="stat-box">
    <label class="stat-label">Encumbrance</label>
    <select name="system.traits.encumbrance">
      <option value="none" {{#if (cts-eq system.traits.encumbrance "none")}}selected{{/if}}>None</option>
      <option value="medium" {{#if (cts-eq system.traits.encumbrance "medium")}}selected{{/if}}>Medium</option>
      <option value="heavy" {{#if (cts-eq system.traits.encumbrance "heavy")}}selected{{/if}}>Heavy</option>
      <option value="overload" {{#if (cts-eq system.traits.encumbrance "overload")}}selected{{/if}}>Overload</option>
    </select>
  </div>
  <div class="stat-box">
    <label class="stat-label" title="Half speed again">Terrain</label>
    <select name="system.traits.difficultTerrain">
      <option value="false" {{#unless system.traits.difficultTerrain}}selected{{/unless}}>Normal</option>
      <option value="true" {{#if system.traits.difficultTerrain}}selected{{/if}}>Difficult (−½)</option>
    </select>
  </div>
  <div class="stat-box">
    <div class="stat-label">Fly</div>
    <input type="number" name="system.attributes.speed.fly.base" value="{{system.attributes.speed.fly.base}}" /> ft
  </div>
  <div class="stat-box">
    <div class="stat-label">Swim</div>
    <input type="number" name="system.attributes.speed.swim.base" value="{{system.attributes.speed.swim.base}}" /> ft
  </div>
  <div class="stat-box">
    <div class="stat-label">Climb</div>
    <input type="number" name="system.attributes.speed.climb.base" value="{{system.attributes.speed.climb.base}}" /> ft
  </div>
</div>

{{!-- Attacks --}}
{{#if items.attacks.length}}
<h3>Attacks</h3>
<ol class="item-list">
  <li class="item-header">
    <span class="flex-grow">Name</span>
    <span style="width:80px;text-align:center;">Type</span>
    <span style="width:60px;text-align:center;">Controls</span>
  </li>
  {{#each items.attacks}}
  <li class="item" data-item-id="{{this._id}}">
    <img class="item-img" src="{{this.img}}" />
    <span class="item-name item-roll flex-grow">{{this.name}}</span>
    <span style="width:80px;text-align:center;">{{this.system.attackType}}</span>
    <div class="item-controls" style="width:60px;text-align:center;">
      <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
      <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
    </div>
  </li>
  {{/each}}
</ol>
{{/if}}
