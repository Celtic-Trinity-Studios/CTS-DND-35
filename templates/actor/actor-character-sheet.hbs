<form class="{{cssClass}}" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <div class="flex-row">
        <input class="char-name flex-grow" name="name" type="text" value="{{actor.name}}" placeholder="Character Name" />
      </div>
      <div class="flex-row">
        <label>Race:</label>
        <input type="text" name="system.details.race" value="{{system.details.race}}" />
        <label>Alignment:</label>
        <select name="system.details.alignment">
          <option value="">—</option>
          {{#each config.alignments as |label key|}}
          <option value="{{key}}" {{#if (cts-eq key ../system.details.alignment)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <label>Deity:</label>
        <input type="text" name="system.details.deity" value="{{system.details.deity}}" />
      </div>
      <div class="flex-row">
        <label>Size:</label>
        <select name="system.traits.size">
          {{#each config.sizes as |label key|}}
          <option value="{{key}}" {{#if (cts-eq key ../system.traits.size)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <div class="charlevel">
          <label>Level: {{system.details.level.value}} XP: <input type="number" name="system.details.xpValue" value="{{system.details.xpValue}}" style="width: 50px;"/></label>
          {{#if (cts-eq system.details.level.value 0)}}
          <button type="button" class="cts-btn open-wizard" style="margin-top: 4px; padding: 2px 4px; font-size: 12px;"><i class="fas fa-magic"></i> Character Wizard</button>
          {{else}}
          <button type="button" class="cts-btn open-levelup" style="margin-top: 4px; padding: 2px 4px; font-size: 12px;"><i class="fas fa-arrow-up"></i> Level Up</button>
          {{/if}}
        </div>
      </div>
    </div>
  </header>

  {{!-- Ability Scores --}}
  {{> "systems/CTS-DND-35/templates/actor/parts/actor-abilities.hbs"}}

  {{!-- Sheet Tabs --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="combat"><i class="fas fa-fist-raised"></i> Combat</a>
    <a class="item" data-tab="features"><i class="fas fa-star"></i> Features</a>
    <a class="item" data-tab="inventory"><i class="fas fa-backpack"></i> Inventory</a>
    <a class="item" data-tab="spells"><i class="fas fa-magic"></i> Spells</a>
    <a class="item" data-tab="skills"><i class="fas fa-tools"></i> Skills</a>
    <a class="item" data-tab="biography"><i class="fas fa-book"></i> Bio</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Combat Tab --}}
    <div class="tab" data-group="primary" data-tab="combat">
      {{> "systems/CTS-DND-35/templates/actor/parts/actor-combat.hbs"}}
    </div>

    {{!-- Features Tab --}}
    <div class="tab" data-group="primary" data-tab="features">
      {{> "systems/CTS-DND-35/templates/actor/parts/actor-features.hbs"}}
    </div>

    {{!-- Inventory Tab --}}
    <div class="tab" data-group="primary" data-tab="inventory">
      {{> "systems/CTS-DND-35/templates/actor/parts/actor-inventory.hbs"}}
    </div>

    {{!-- Spells Tab --}}
    <div class="tab" data-group="primary" data-tab="spells">
      {{> "systems/CTS-DND-35/templates/actor/parts/actor-spells.hbs"}}
    </div>

    {{!-- Skills Tab --}}
    <div class="tab" data-group="primary" data-tab="skills">
      {{> "systems/CTS-DND-35/templates/actor/parts/actor-skills.hbs"}}
    </div>

    {{!-- Biography Tab --}}
    <div class="tab" data-group="primary" data-tab="biography">
      {{> "systems/CTS-DND-35/templates/actor/parts/actor-biography.hbs"}}
    </div>
  </section>
</form>
