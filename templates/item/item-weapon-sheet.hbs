<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="48" width="48" />
    <div class="header-fields">
      <input class="char-name flex-grow" name="name" type="text" value="{{item.name}}" />
      <span class="stat-label" style="text-transform:uppercase;">{{item.type}}</span>
    </div>
  </header>
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description"><i class="fas fa-book"></i> Description</a>
    <a class="item" data-tab="details"><i class="fas fa-cog"></i> Details</a>
  </nav>
  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="description">
      <h3>Description</h3>
      {{editor enrichedDescription target="system.description" button=true editable=editable}}
    </div>
    <div class="tab" data-group="primary" data-tab="details">
      {{#if derived.attackLabel}}
      <p class="notes">On the owning actor: <strong>{{derived.attackLabel}}</strong> · {{derived.damageFormula}} · threat {{derived.threat}}–20 / ×{{derived.multiplier}}</p>
      {{/if}}
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Attack mode</label>
          <select name="system.weaponSubtype">
            <option value="melee" {{#if (cts-eq system.weaponSubtype "melee")}}selected{{/if}}>Melee</option>
            <option value="ranged" {{#if (cts-eq system.weaponSubtype "ranged")}}selected{{/if}}>Ranged</option>
            <option value="touch" {{#if (cts-eq system.weaponSubtype "touch")}}selected{{/if}}>Touch</option>
            <option value="rangedTouch" {{#if (cts-eq system.weaponSubtype "rangedTouch")}}selected{{/if}}>Ranged touch</option>
            <option value="thrown" {{#if (cts-eq system.weaponSubtype "thrown")}}selected{{/if}}>Thrown</option>
          </select>
        </div>
        <div class="form-group flex-grow">
          <label>Weapon type</label>
          <select name="system.weaponType">
            {{#each config.weaponTypes as |label key|}}
            <option value="{{key}}" {{#if (cts-eq ../system.weaponType key)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Damage</label>
          <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="1d8" />
        </div>
        <div class="form-group flex-grow">
          <label>Damage type</label>
          <input type="text" name="system.damageType" value="{{system.damageType}}" placeholder="slashing, fire" />
        </div>
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Enhancement</label>
          <input type="number" name="system.enhancement" value="{{system.enhancement}}" step="1" />
        </div>
        <div class="form-group flex-grow">
          <label>Attack misc</label>
          <input type="number" name="system.attackMisc" value="{{system.attackMisc}}" step="1" />
        </div>
        <div class="form-group flex-grow">
          <label>Ability override</label>
          <select name="system.ability">
            <option value="" {{#unless system.ability}}selected{{/unless}}>Auto</option>
            {{#each config.abilities as |label key|}}
            <option value="{{key}}" {{#if (cts-eq ../system.ability key)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Range increments</label>
          <input type="number" name="system.rangeIncrements" value="{{system.rangeIncrements}}" min="1" step="1" title="How many increments away. Each after the first is −2." />
        </div>
        <div class="form-group flex-grow">
          <label>Material</label>
          <input type="text" name="system.material" value="{{system.material}}" placeholder="silver, adamantine" />
        </div>
        <div class="form-group flex-grow">
          <label>Alignment</label>
          <input type="text" name="system.alignment" value="{{system.alignment}}" placeholder="good, chaotic" />
        </div>
      </div>
      <div class="flexrow" style="gap:8px; flex-wrap:wrap;">
        <label><select name="system.keen"><option value="false" {{#unless system.keen}}selected{{/unless}}>Not keen</option><option value="true" {{#if system.keen}}selected{{/if}}>Keen (doubles threat)</option></select></label>
        <label><select name="system.magic"><option value="false" {{#unless system.magic}}selected{{/unless}}>Magic from enhancement</option><option value="true" {{#if system.magic}}selected{{/if}}>Counts as magic</option></select></label>
        <label><select name="system.nonlethal"><option value="false" {{#unless system.nonlethal}}selected{{/unless}}>Lethal</option><option value="true" {{#if system.nonlethal}}selected{{/if}}>Nonlethal</option></select></label>
        <label><select name="system.consumeAmmo"><option value="false" {{#unless system.consumeAmmo}}selected{{/unless}}>Do not spend ammo</option><option value="true" {{#if system.consumeAmmo}}selected{{/if}}>Spend 1 quantity per roll</option></select></label>
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Threat (natural)</label>
          <input type="number" name="system.critRange" value="{{system.critRange}}" min="1" max="20" placeholder="20" />
        </div>
        <div class="form-group flex-grow">
          <label>Crit multiplier</label>
          <input type="number" name="system.critMultiplier" value="{{system.critMultiplier}}" min="2" step="1" placeholder="2" />
        </div>
      </div>
      <div class="flexrow" style="gap:8px; flex-wrap:wrap;">
        <label><select name="system.proficient"><option value="true" {{#if system.proficient}}selected{{/if}}>Proficient</option><option value="false" {{#unless system.proficient}}selected{{/unless}}>Not proficient (−4)</option></select></label>
        <label><select name="system.finesse"><option value="false" {{#unless system.finesse}}selected{{/unless}}>No finesse</option><option value="true" {{#if system.finesse}}selected{{/if}}>Finesse (Dex if better)</option></select></label>
        <label><select name="system.twoHanded"><option value="false" {{#unless system.twoHanded}}selected{{/unless}}>One-handed</option><option value="true" {{#if system.twoHanded}}selected{{/if}}>Two-handed (Str ×1.5)</option></select></label>
        <label><select name="system.offHand"><option value="false" {{#unless system.offHand}}selected{{/unless}}>Primary</option><option value="true" {{#if system.offHand}}selected{{/if}}>Off-hand (½ Str, one attack)</option></select></label>
        <label><select name="system.secondary"><option value="false" {{#unless system.secondary}}selected{{/unless}}>Primary natural</option><option value="true" {{#if system.secondary}}selected{{/if}}>Secondary natural (−5, ½ Str)</option></select></label>
        <label><select name="system.light"><option value="" {{#unless system.light}}selected{{/unless}}>Light: guess from name</option><option value="true" {{#if (cts-eq system.light "true")}}selected{{/if}}>Light</option><option value="false" {{#if (cts-eq system.light "false")}}selected{{/if}}>Not light</option></select></label>
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>{{localize "CTSDND35.Weight"}} (lb)</label>
          <input type="number" name="system.weight" value="{{system.weight}}" step="0.1" min="0" />
        </div>
        <div class="form-group flex-grow">
          <label>{{localize "CTSDND35.Quantity"}}</label>
          <input type="number" name="system.quantity" value="{{system.quantity}}" step="1" min="1" />
        </div>
      </div>
      <p class="notes">Click the weapon name on the character sheet to roll each iterative attack, a confirmation roll on a threat, and damage. Compendium weapons that only store damage in <code>damage.parts</code> still roll. Set Damage here to override that formula. Two-weapon fighting penalties go in Attack misc.</p>
    </div>
  </section>
</form>
