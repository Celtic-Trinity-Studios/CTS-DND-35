<form class="cts-dnd-35 wizard wizard-classic" autocomplete="off" onsubmit="event.preventDefault();">
  <div class="wizard-classic-title">Character Generation</div>
  <div class="wizard-classic-body">
    <aside class="wizard-classic-nav">
      <button type="button" class="step-indicator {{#if isStep1}}active{{/if}}" data-step="1">Gender</button>
      <button type="button" class="step-indicator {{#if isStep2}}active{{/if}}" data-step="2">Race</button>
      <button type="button" class="step-indicator {{#if isStep3}}active{{/if}}" data-step="3">Class</button>
      <button type="button" class="step-indicator {{#if isStep4}}active{{/if}}" data-step="4">Alignment</button>
      <button type="button" class="step-indicator {{#if isStep5}}active{{/if}}" data-step="5">Abilities</button>
      <button type="button" class="step-indicator {{#if isStep6}}active{{/if}}" data-step="6">Skills</button>
      <button type="button" class="step-indicator {{#if isStep7}}active{{/if}}" data-step="7">Feats</button>
      <button type="button" class="step-indicator {{#if isStep8}}active{{/if}}" data-step="8">Spells</button>
      <div class="wizard-nav-spacer"></div>
      <button type="button" class="cts-btn secondary cancel-wizard">Cancel</button>
      {{#if isStep8}}
      <button type="button" class="cts-btn apply-wizard">Play</button>
      {{/if}}
    </aside>

    <section class="wizard-content wizard-classic-content">
      {{#if isStep1}}
      <div class="wizard-step-head"><h3>Select the Gender of your Character</h3></div>
      <div class="wizard-split">
        <div class="wizard-scroll-list wizard-choice-list">
          {{#each genderChoices as |gender|}}
          <button type="button" class="wizard-choice-button gender-choice {{#if gender.selected}}active{{/if}}" data-gender="{{gender.key}}">
            {{gender.label}}
          </button>
          {{/each}}
        </div>
        <div class="wizard-detail-column">
          <h4>{{activeGenderLabel}}</h4>
          <div class="wizard-detail-body">
            <p>{{activeGenderDescription}}</p>
            <div class="form-group">
              <label>Character Name</label>
              <input type="text" data-prop="basics.name" value="{{state.basics.name}}" />
            </div>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if isStep2}}
      <div class="wizard-step-head"><h3>Select a Race for your Character</h3></div>
      <div class="wizard-split">
        <div class="wizard-scroll-list wizard-choice-list">
          {{#each raceChoices as |race|}}
          <button type="button" class="wizard-choice-button race-choice {{#if race.selected}}active{{/if}}" data-race="{{race.key}}">
            {{race.label}}
          </button>
          {{/each}}
        </div>
        <div class="wizard-detail-column">
          <h4>{{activeRaceLabel}}</h4>
          <div class="wizard-detail-body">
            <p>{{activeRaceDescription}}</p>
            <p><strong>Size:</strong> {{currentRace.size}} | <strong>Speed:</strong> {{currentRace.speed}}</p>
            <p><strong>Ability Modifiers:</strong> {{activeRaceAbilityMods}}</p>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if isStep3}}
      <div class="wizard-step-head"><h3>Select a Class for your Character</h3></div>
      <div class="wizard-actions-row">
        <button type="button" class="cts-btn secondary toggle-unavailable wizard-toggle-unavailable">
          {{#if showUnavailableOptions}}Hide Unavailable{{else}}Show Unavailable{{/if}}
        </button>
      </div>
      <div class="form-group">
        <label>Search</label>
        <input type="text" data-prop="classSearch" value="{{state.classSearch}}" placeholder="Type here to search classes" />
      </div>
      <div class="wizard-split">
        <div class="wizard-scroll-list">
          {{#each classChoicesForSelect as |c|}}
          <div class="class-choice wizard-choice-button {{#if (cts-eq c.uuid ../classListActiveUuid)}}active{{/if}}" data-uuid="{{c.uuid}}">
            <strong>{{c.name}}</strong>
            {{#unless c.available}}
            <div class="notes" style="color:#c94c4c;">Unavailable: {{c.unavailableReason}}</div>
            {{/unless}}
          </div>
          {{/each}}
        </div>
        <div class="wizard-detail-column">
          <h4>{{#if activeClass}}{{activeClass.name}}{{else}}Select a class{{/if}}</h4>
          <div class="wizard-detail-body">{{#if activeClass}}{{{activeClass.description}}}{{else}}<p class="notes">Choose a class from the list.</p>{{/if}}</div>
          <div class="wizard-inline-actions flexcol" style="margin-top:8px;">
            <button type="button" class="cts-btn set-primary-class">Set as Primary</button>
            {{#if allowGestalt}}
            <button type="button" class="cts-btn secondary set-secondary-class" style="margin-top:6px;">Set as Secondary</button>
            {{/if}}
          </div>
          <div class="form-group" style="margin-top:8px;">
            <label>Primary Class Level</label>
            <input type="number" data-prop="classLevels.primary" value="{{state.classLevels.primary}}" min="1" />
          </div>
          {{#if allowGestalt}}
          <div class="form-group">
            <label>Secondary Class Level</label>
            <input type="number" data-prop="classLevels.secondary" value="{{state.classLevels.secondary}}" min="0" />
          </div>
          {{/if}}
        </div>
      </div>
      {{/if}}

      {{#if isStep4}}
      <div class="wizard-step-head"><h3>Select an Alignment for your Character</h3></div>
      <div class="wizard-split">
        <div class="wizard-scroll-list wizard-choice-list wizard-grid-list">
          {{#each alignmentChoices as |align|}}
          <button type="button" class="wizard-choice-button alignment-choice {{#if align.selected}}active{{/if}}" data-alignment="{{align.key}}">
            {{align.label}}
          </button>
          {{/each}}
        </div>
        <div class="wizard-detail-column">
          <h4>{{activeAlignmentLabel}}</h4>
          <div class="wizard-detail-body">
            <p>{{activeAlignmentDescription}}</p>
            <div class="form-group">
              <label>Deity (optional)</label>
              <input type="text" data-prop="basics.deity" value="{{state.basics.deity}}" />
            </div>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if isStep5}}
      <div class="wizard-step-head"><h3>Select Ability Scores for your Character</h3></div>
      <div class="form-group">
        <label>Generation Method</label>
        <select data-prop="abilityMethod">
          <option value="array" {{#if (cts-eq state.abilityMethod "array")}}selected{{/if}}>Standard Array</option>
          <option value="pointbuy" {{#if (cts-eq state.abilityMethod "pointbuy")}}selected{{/if}}>Point Buy</option>
          <option value="roll" {{#if (cts-eq state.abilityMethod "roll")}}selected{{/if}}>Roll 4d6 drop lowest</option>
        </select>
      </div>
      {{#if (cts-eq state.abilityMethod "roll")}}
      <div class="wizard-actions-row">
        <button type="button" class="roll-stats cts-btn"><i class="fas fa-dice"></i> Roll Abilities</button>
      </div>
      {{/if}}
      <div class="wizard-split">
        <div class="wizard-scroll-list">
          {{#each config.abilities as |label key|}}
          <div class="wizard-ability-row">
            <span>{{label}}</span>
            <div class="wizard-ability-controls">
              <button type="button" class="ability-dec" data-ability="{{key}}">-</button>
              <input type="number" data-prop="abilities.{{key}}" value="{{lookup ../state.abilities key}}" min="8" max="18" />
              <button type="button" class="ability-inc" data-ability="{{key}}">+</button>
              <span class="notes">Mod {{cts-sign (lookup ../abilityMods key)}}</span>
            </div>
          </div>
          {{/each}}
          <p class="notes" style="margin-top:8px;">Point Buy Remaining: <strong>{{pointBuyRemaining}}</strong></p>
        </div>
        <div class="wizard-detail-column">
          <h4>Description of Abilities</h4>
          <div class="wizard-detail-body">
            <p>{{abilityStepDescription}}</p>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if isStep6}}
      <div class="wizard-step-head"><h3>Allocate Skill Points</h3></div>
      <p class="notes">
        {{primaryClassLabel}} points: <strong>{{skillBudget.primaryRemaining}}</strong> / {{skillBudget.primary}}
        {{#if allowGestalt}}
        &nbsp;|&nbsp; {{secondaryClassLabel}} points: <strong>{{skillBudget.secondaryRemaining}}</strong> / {{skillBudget.secondary}}
        {{/if}}
      </p>
      <div class="wizard-skill-table-wrap">
        <div class="flexrow" style="font-weight: bold; margin-bottom: 6px;">
          <div style="flex: 2;">Skill</div>
          <div style="flex: 1; text-align:center;">Total</div>
          <div style="flex: 1; text-align:center;">{{primaryClassLabel}}</div>
          {{#if allowGestalt}}<div style="flex: 1; text-align:center;">{{secondaryClassLabel}}</div>{{/if}}
          <div style="flex: 0.7; text-align:center;">Ability</div>
        </div>
        {{#each skillRows as |row|}}
        <div class="flexrow" style="align-items: center; margin-bottom: 4px;">
          <div style="flex: 2;">{{row.label}}</div>
          <div style="flex: 1; text-align:center; font-weight:bold;">{{row.total}}</div>
          <div style="flex: 1; text-align:center;">
            <button type="button" class="skill-dec" data-which="primary" data-skill="{{row.key}}">-</button>
            <span style="display:inline-block; min-width: 20px;">{{row.primaryRanks}}</span>
            <button type="button" class="skill-inc" data-which="primary" data-skill="{{row.key}}">+</button>
          </div>
          {{#if ../allowGestalt}}
          <div style="flex: 1; text-align:center;">
            <button type="button" class="skill-dec" data-which="secondary" data-skill="{{row.key}}">-</button>
            <span style="display:inline-block; min-width: 20px;">{{row.secondaryRanks}}</span>
            <button type="button" class="skill-inc" data-which="secondary" data-skill="{{row.key}}">+</button>
          </div>
          {{/if}}
          <div style="flex: 0.7; text-align:center;">{{row.ability}}</div>
        </div>
        {{/each}}
      </div>
      {{/if}}

      {{#if isStep7}}
      <div class="wizard-step-head"><h3>Feats</h3></div>
      <div class="wizard-actions-row">
        <button type="button" class="cts-btn secondary toggle-unavailable wizard-toggle-unavailable">
          {{#if showUnavailableOptions}}Hide Unavailable{{else}}Show Unavailable{{/if}}
        </button>
      </div>
      <p class="notes">{{#if featsRemaining}}Choose feats.{{else}}No more feats may be added.{{/if}} Remaining: <strong>{{featsRemaining}}</strong> / {{featSlots}}</p>
      <div class="wizard-split wizard-feat-split">
        <div class="wizard-feat-left">
          <div class="form-group">
            <label>Search</label>
            <input type="text" data-prop="featSearch" value="{{state.featSearch}}" placeholder="Type here to search" />
          </div>
          <div class="form-group">
            <label>Type</label>
            <select data-prop="featTypeFilter">
              <option value="all" {{#if (cts-eq state.featTypeFilter "all")}}selected{{/if}}>Everything</option>
              {{#each featTypes as |type|}}
              <option value="{{type}}" {{#if (cts-eq type ../state.featTypeFilter)}}selected{{/if}}>{{type}}</option>
              {{/each}}
            </select>
          </div>
          <div class="wizard-scroll-list">
            {{#each featChoices as |feat|}}
            <div class="feat-choice wizard-choice-button {{#if (cts-eq feat.uuid ../state.activeFeatUuid)}}active{{/if}}" data-uuid="{{feat.uuid}}">
              <strong>{{feat.name}}</strong>
              <span class="notes"> — {{feat.type}}</span>
              {{#if ../showUnavailableOptions}}
              {{#unless feat.prereqOk}}
              <div class="notes" style="color:#c94c4c;">Prereq not met: {{feat.prereqReason}}</div>
              {{/unless}}
              {{/if}}
            </div>
            {{/each}}
          </div>
        </div>
        <div class="wizard-detail-column">
          <h4>{{#if activeFeat}}{{activeFeat.name}}{{else}}Select a feat{{/if}}</h4>
          <div class="wizard-detail-body">
            {{#if activeFeat}}
            {{{activeFeat.description}}}
            {{#if activeFeat.prereqReason}}
            <hr />
            <p class="notes" style="color:#c94c4c; margin:0;">{{activeFeat.prereqReason}}</p>
            {{/if}}
            {{else}}
            <p class="notes">Select a feat from the list.</p>
            {{/if}}
          </div>
          <div class="wizard-inline-actions" style="margin-top:8px;">
            <button type="button" class="cts-btn add-feat">Add</button>
          </div>
          <div style="margin-top:12px;">
            <strong>Selected:</strong>
            {{#if selectedFeats.length}}
              {{#each selectedFeats as |feat|}}
              <div class="flexrow" style="align-items:center; margin-top:4px;">
                <span style="flex:1;">{{feat.name}}</span>
                <button type="button" class="remove-feat cts-btn secondary" data-uuid="{{feat.uuid}}">Remove</button>
              </div>
              {{/each}}
            {{else}}
              <div class="notes">No feats selected yet.</div>
            {{/if}}
          </div>
        </div>
      </div>
      {{/if}}

      {{#if isStep8}}
      <div class="wizard-step-head"><h3>Starting Spells</h3></div>
      {{#if isSpontaneousCaster}}
      <p class="notes">Known picks: <strong>{{spellPickCount}}</strong> / {{spellPickCap}}</p>
      {{/if}}
      {{#if isPreparedCaster}}
      <p class="notes">Prepared caster mode: spell picks are optional references (no strict known-spell cap).</p>
      {{/if}}
      {{#if isSpontaneousCaster}}
      <p class="notes" style="margin-top:2px;">
        {{#each spellPickCapsByLevel}}
          L{{@key}}: {{lookup ../spellPickCountByLevel @key}} / {{this}}&nbsp;
        {{/each}}
      </p>
      {{/if}}
      <div class="wizard-split">
        <div class="wizard-detail-column" style="flex: 1 1 42%; min-width:0;">
          <div class="form-group">
            <label>Spell Search</label>
            <input type="text" data-prop="spellSearch" value="{{state.spellSearch}}" placeholder="Type here to search class spells" />
          </div>
          <div class="wizard-scroll-list">
            {{#each availableSpells as |spell|}}
            <div class="spell-choice wizard-choice-button {{#if (cts-eq spell.uuid ../state.activeSpellUuid)}}active{{/if}}" data-uuid="{{spell.uuid}}">
              <strong>{{spell.name}}</strong>
              <span class="notes"> ({{spell.spellLevel}})</span>
            </div>
            {{/each}}
          </div>
        </div>
        <div class="wizard-detail-column" style="flex: 1 1 58%; min-width:0;">
          <h4>{{#if activeSpell}}{{activeSpell.name}}{{else}}Select a spell{{/if}}</h4>
          <div class="wizard-detail-body">
            {{#if activeSpell}}{{{activeSpell.description}}}{{else}}<p class="notes">Choose a spell from the list.</p>{{/if}}
          </div>
          <div class="wizard-inline-actions" style="margin-top:8px;">
            <button type="button" class="cts-btn add-spell">Add</button>
          </div>
          <div style="margin-top:12px;">
            <strong>Selected Spells</strong>
            {{#if selectedSpells.length}}
              {{#each selectedSpells as |spell|}}
              <div class="flexrow" style="align-items:center; margin-top:4px;">
                <span style="flex:1;">{{spell.name}} ({{spell.spellLevel}})</span>
                <button type="button" class="remove-spell cts-btn secondary" data-uuid="{{spell.uuid}}">Remove</button>
              </div>
              {{/each}}
            {{else}}
              <p class="notes" style="margin:6px 0 0;">No spells selected.</p>
            {{/if}}
          </div>
        </div>
      </div>
      {{/if}}
    </section>
  </div>
</form>
