{{!-- Status tab: sub-panels Conditions | Spells, then buffs --}}
<section class="cts-panel-block cts-status-panel">
  <h3><i class="fas fa-notes-medical"></i> Status</h3>
  <p class="cts-tab-hint cts-status-hint">Tick conditions on <strong>Conditions</strong>. Dragging from the <strong>SRD Spells</strong> compendium adds <strong>Spell</strong> items — open the <strong>Spells</strong> sub-tab to see them (they are not buffs). Use <strong>Buff</strong> items only in the section below for ongoing effects you model as items.</p>

  <nav class="cts-status-subtabs" aria-label="Status sections">
    <button type="button" class="item active" data-cts-status-sub="conditions">Conditions</button>
    <button type="button" class="item" data-cts-status-sub="spells">Spells</button>
  </nav>

  <div class="cts-status-subpanes">
    <div class="cts-status-subpane is-active" data-cts-status-sub="conditions">
      <fieldset class="cts-condition-fieldset">
        <legend class="cts-sr-only">Condition toggles</legend>
        <div class="cts-condition-grid">
          {{#each statusConditionRows}}
          <label class="cts-condition-chip {{#if this.on}}is-on{{/if}}">
            <input type="checkbox" data-condition-key="{{this.key}}" {{#if this.on}}checked{{/if}} />
            <span>{{this.label}}</span>
          </label>
          {{/each}}
        </div>
      </fieldset>

      <div class="cts-status-vitals">
        <label>Vitality / awareness
          <select name="system.details.status.vitality">
            <option value="normal" {{#if (cts-eq system.details.status.vitality "normal")}}selected{{/if}}>Normal</option>
            <option value="unconscious" {{#if (cts-eq system.details.status.vitality "unconscious")}}selected{{/if}}>Unconscious</option>
            <option value="stable" {{#if (cts-eq system.details.status.vitality "stable")}}selected{{/if}}>Stable (0 HP)</option>
            <option value="dying" {{#if (cts-eq system.details.status.vitality "dying")}}selected{{/if}}>Dying</option>
            <option value="disabled" {{#if (cts-eq system.details.status.vitality "disabled")}}selected{{/if}}>Disabled</option>
            <option value="dead" {{#if (cts-eq system.details.status.vitality "dead")}}selected{{/if}}>Dead</option>
          </select>
        </label>
      </div>

      <label class="cts-full-width cts-status-notes-label">Status notes<br />
        <textarea name="system.details.status.notes" rows="4" placeholder="Rounds, sources, house rules…">{{system.details.status.notes}}</textarea>
      </label>
    </div>

    <div class="cts-status-subpane" data-cts-status-sub="spells">
      <div class="cts-status-spells-wrap">
        {{#if hasActorSpells}}
        {{> "systems/CTS-DND-35/templates/actor/parts/actor-spells.hbs"}}
        {{else}}
        <p class="cts-tab-hint">No spell items on this actor yet. Add <strong>Spell</strong> items from the Items sidebar or a compendium.</p>
        {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="cts-panel-block cts-status-buffs">
  <h3><i class="fas fa-bolt"></i> Buffs &amp; effects (items)</h3>
  <p class="cts-tab-hint cts-status-buffs-hint">Only <strong>type: Buff</strong> items appear here (create in Items, or import a buff compendium if you add one). Spells from compendia are <strong>Spell</strong> items — use the <strong>Spells</strong> sub-tab. Drop items onto <strong>anywhere on this character sheet form</strong> or onto the actor in the sidebar.</p>
  {{#each items.buffs}}
  <div class="cts-line item" data-item-id="{{this._id}}">
    <img class="item-img" src="{{this.img}}" alt="" />
    <span class="item-name item-roll flex-grow">{{this.name}}</span>
    <span class="cts-buff-active" title="Active on item">{{#if this.system.active}}✓{{else}}—{{/if}}</span>
    <span class="cts-line-controls">
      <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
      <a class="item-delete" title="Remove"><i class="fas fa-trash"></i></a>
    </span>
  </div>
  {{else}}
  <p class="cts-tab-hint">No buff items yet.</p>
  {{/each}}
</section>
