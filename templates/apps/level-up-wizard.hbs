<form class="cts-dnd-35 wizard" autocomplete="off" onsubmit="event.preventDefault();">
  <header class="wizard-header flexrow">
    <button type="button" class="step-indicator {{#if isStep1}}active{{/if}}" data-step="1">1. Class & HP</button>
    <button type="button" class="step-indicator {{#if isStep2}}active{{/if}}" data-step="2">2. Skills</button>
    <button type="button" class="step-indicator {{#if isStep3}}active{{/if}}" data-step="3">3. Feat</button>
  </header>

  <div class="wizard-content">
    {{#if isStep1}}
    <h3 style="margin-top:0;">Level {{nextLevel}} Advancement</h3>
    <p class="notes">Current level: {{totalLevel}} | New class level after gain: {{classLevelAfterGain}}</p>

    <div class="form-group">
      <label>Class to Advance</label>
      <select data-prop="selectedClassUuid">
        <option value="">-- Select class --</option>
        {{#each availableClassChoices as |c|}}
        <option value="{{c.uuid}}" {{#if (cts-eq c.uuid ../state.selectedClassUuid)}}selected{{/if}}>{{c.name}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label>HP Gain Method</label>
      <select data-prop="hpMethod">
        <option value="fixed" {{#if (cts-eq state.hpMethod "fixed")}}selected{{/if}}>Fixed Average</option>
        <option value="max" {{#if (cts-eq state.hpMethod "max")}}selected{{/if}}>Max HP</option>
        <option value="roll" {{#if (cts-eq state.hpMethod "roll")}}selected{{/if}}>Roll Hit Die</option>
        <option value="manual" {{#if (cts-eq state.hpMethod "manual")}}selected{{/if}}>Manual</option>
      </select>
    </div>

    <div class="form-group">
      <label>HP Gain</label>
      <input type="number" data-prop="hpManual" value="{{state.hpManual}}" min="1" />
      <button type="button" class="cts-btn secondary roll-hp" style="margin-left:8px;">Roll HP</button>
    </div>
    <p class="notes">Preview HP gain: <strong>{{hpGainPreview}}</strong></p>
    {{#if pendingFeatures.length}}
    <p class="notes" style="margin-bottom:4px;"><strong>Class Features Gained</strong></p>
    <ul style="max-height:100px; overflow-y:auto; margin-top:0;">
      {{#each pendingFeatures as |feat|}}
      <li>{{feat.name}}</li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if spellcastingPreview}}
    <p class="notes">
      Spellcasting update: {{spellcastingPreview.data.className}} ({{spellcastingPreview.data.type}})
      caster level {{spellcastingPreview.data.casterLevel}}
      {{#if spellcastingPreview.data.ability}}using {{spellcastingPreview.data.ability}}{{/if}}.
    </p>
    {{/if}}
    {{/if}}

    {{#if isStep2}}
    <h3 style="margin-top:0;">Skill Allocation</h3>
    <p class="notes">Points remaining: <strong>{{skillPointRemaining}}</strong> / {{skillPointBudget}}</p>

    <div style="max-height: 430px; overflow-y: auto; border: 1px solid var(--cts-border-dark); padding: 6px;">
      <div class="flexrow" style="font-weight: bold; margin-bottom: 6px;">
        <div style="flex: 2;">Skill</div>
        <div style="flex: 0.7; text-align:center;">Curr</div>
        <div style="flex: 1; text-align:center;">Add</div>
        <div style="flex: 0.7; text-align:center;">Ability</div>
        <div style="flex: 0.7; text-align:center;">Cap</div>
        <div style="flex: 0.6; text-align:center;">Cost</div>
        <div style="flex: 0.9; text-align:center;">Total</div>
      </div>
      {{#each skillRows as |row|}}
      <div class="flexrow" style="align-items: center; margin-bottom: 4px;">
        <div style="flex: 2;">
          {{#if row.isClassSkill}}<i class="fas fa-star" style="color:var(--cts-accent); margin-right:4px;"></i>{{/if}}
          {{row.label}}
        </div>
        <div style="flex: 0.7; text-align:center;">{{row.currentRanks}}</div>
        <div style="flex: 1; text-align:center;">
          <button type="button" class="skill-dec" data-skill="{{row.key}}">-</button>
          <span style="display:inline-block; min-width: 20px;">{{row.addRanks}}</span>
          <button type="button" class="skill-inc" data-skill="{{row.key}}">+</button>
        </div>
        <div style="flex: 0.7; text-align:center;">{{row.ability}}</div>
        <div style="flex: 0.7; text-align:center;">{{row.rankCap}}</div>
        <div style="flex: 0.6; text-align:center;">{{row.pointCost}}</div>
        <div style="flex: 0.9; text-align:center; font-weight: bold;">{{cts-sign row.projectedTotal}}</div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if isStep3}}
    <h3 style="margin-top:0;">Feat & Spell Selection</h3>
    {{#if requiresFeatChoice}}
    <p class="notes">This level grants a feat choice. Choose one to continue.</p>
    {{else}}
    <p class="notes">No general feat gained at this level. Feat choice is optional.</p>
    {{/if}}

    <div class="form-group">
      <label>Search</label>
      <input type="text" data-prop="featSearch" value="{{state.featSearch}}" placeholder="Type here to search" />
    </div>
    <div class="form-group">
      <label>Feat</label>
      <select data-prop="selectedFeatUuid">
        <option value="">-- None --</option>
        {{#each featChoices as |feat|}}
        <option value="{{feat.uuid}}" {{#if (cts-eq feat.uuid ../state.selectedFeatUuid)}}selected{{/if}} {{#if (cts-eq feat.prereqOk false)}}disabled{{/if}}>
          {{feat.name}} ({{feat.type}}){{#if (cts-eq feat.prereqOk false)}} - unmet prereq{{/if}}
        </option>
        {{/each}}
      </select>
    </div>
    {{#if state.selectedFeatUuid}}
      {{#each featChoices as |feat|}}
        {{#if (cts-eq feat.uuid ../state.selectedFeatUuid)}}
          {{#if (cts-eq feat.prereqOk false)}}
          <p class="notes" style="color: var(--cts-danger);">Missing prerequisites: {{feat.prereqReason}}</p>
          {{/if}}
        {{/if}}
      {{/each}}
    {{/if}}

    {{#if spellcastingPreview}}
    <hr />
    <p class="notes">
      Caster progression allows spells up to level <strong>{{maxSpellLevel}}</strong>.
      {{#if isSpontaneousCaster}}Known picks: <strong>{{spellPickCount}}</strong> / {{spellPickCap}}.{{/if}}
      {{#if isPreparedCaster}}Prepared caster mode: picks are optional references (no strict known-spell cap).{{/if}}
    </p>
    {{#if isSpontaneousCaster}}
    <p class="notes" style="margin-top:2px;">
      {{#each spellPickCapsByLevel}}
        L{{@key}}: {{lookup ../spellPickCountByLevel @key}} / {{this}}&nbsp;
      {{/each}}
    </p>
    {{/if}}
    <div class="form-group">
      <label>Spell Search</label>
      <input type="text" data-prop="spellSearch" value="{{state.spellSearch}}" placeholder="Type here to search class spells" />
    </div>
    <div class="flexrow" style="gap:8px;">
      <div style="flex:1; max-height:190px; overflow-y:auto; border:1px solid var(--cts-border-dark);">
        {{#each availableSpells as |spell|}}
        <div class="spell-choice" data-uuid="{{spell.uuid}}" style="padding:4px 6px; cursor:pointer; border-bottom:1px solid var(--cts-border-dark);">
          <strong>{{spell.name}}</strong>
          <span class="notes"> ({{spell.spellLevel}})</span>
        </div>
        {{/each}}
      </div>
      <div style="flex:1; max-height:190px; overflow-y:auto; border:1px solid var(--cts-border-dark); padding:6px;">
        <strong>Selected Spells</strong>
        {{#if selectedSpells.length}}
          {{#each selectedSpells as |spell|}}
          <div class="flexrow" style="align-items:center; margin-top:4px;">
            <span style="flex:1;">{{spell.name}} ({{spell.spellLevel}})</span>
            <button type="button" class="remove-spell" data-uuid="{{spell.uuid}}">Remove</button>
          </div>
          {{/each}}
        {{else}}
        <p class="notes" style="margin:6px 0 0;">No spells selected.</p>
        {{/if}}
      </div>
    </div>
    {{/if}}
    {{/if}}
  </div>

  <footer class="wizard-footer flexrow" style="gap:8px; margin-top:16px; padding-top:16px; border-top:1px solid var(--cts-border-dark);">
    <button type="button" class="cts-btn apply-levelup" style="flex:1;">Apply Level Up</button>
  </footer>
</form>
