{{!-- Combat Stats Partial --}}

{{!-- HP --}}
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">HP</div>
    <div class="hp-bar">
      <input type="number" name="system.attributes.hp.value" value="{{system.attributes.hp.value}}" />
      <span class="hp-sep">/</span>
      <input type="number" name="system.attributes.hp.max" value="{{system.attributes.hp.max}}" />
    </div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Temp HP</div>
    <input type="number" name="system.attributes.hp.temp" value="{{system.attributes.hp.temp}}" title="Manual temp HP total" />
  </div>
  <div class="stat-box">
    <div class="stat-label">Temp (tracked)</div>
    <span class="stat-value derived" title="Sum of sources below">{{system.attributes.hp.tempSourcesSum}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">Nonlethal</div>
    <input type="number" name="system.attributes.hp.nonlethal" value="{{system.attributes.hp.nonlethal}}" />
  </div>
  {{#if system.attributes.hp.toughnessBonus}}
  <div class="stat-box">
    <div class="stat-label">Toughness</div>
    <span class="stat-value derived" title="Add this to max HP once">+{{system.attributes.hp.toughnessBonus}}</span>
  </div>
  {{/if}}
  <div class="stat-box">
    <div class="stat-label">Neg. levels</div>
    <input type="number" name="system.attributes.negativeLevels" value="{{system.attributes.negativeLevels}}" min="0" step="1" title="−1 saves/skills/init/grapple per level (SRD)" />
  </div>
</div>

<div class="cts-temp-hp-sources mb-md">
  <span class="stat-label">Temp HP sources</span>
  {{#each system.attributes.hp.tempSources}}
  <div class="flexrow cts-temp-hp-row" data-index="{{@index}}">
    <input type="text" name="system.attributes.hp.tempSources.{{@index}}.label" value="{{this.label}}" placeholder="Source" class="flex-grow" />
    <input type="number" name="system.attributes.hp.tempSources.{{@index}}.amount" value="{{this.amount}}" min="0" step="1" style="width:56px;" />
    <button type="button" class="cts-icon-btn cts-remove-temp-hp" data-index="{{@index}}" title="Remove"><i class="fas fa-trash"></i></button>
  </div>
  {{else}}
  <p class="notes">No rows — add one for rage, aid, etc.</p>
  {{/each}}
  <button type="button" class="cts-btn secondary cts-add-temp-hp"><i class="fas fa-plus"></i> Add temp HP source</button>
</div>

{{!-- AC — computed, read-only display --}}
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">AC</div>
    <div class="stat-value derived">{{system.attributes.ac.normal}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Touch</div>
    <div class="stat-value derived">{{system.attributes.ac.touch}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Flat-Footed</div>
    <div class="stat-value derived">{{system.attributes.ac.flatFooted}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Natural</div>
    <input type="number" name="system.attributes.ac.naturalArmor" value="{{system.attributes.ac.naturalArmor}}" title="Natural Armor (manual override)" />
  </div>
  {{#if system.attributes.ac.effectiveMaxDex}}
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncMaxDexCap"}}</div>
    <span class="stat-value derived">{{system.attributes.ac.effectiveMaxDex}}</span>
  </div>
  {{/if}}
  {{#if system.attributes.ac.prone}}
  <div class="stat-box">
    <div class="stat-label">AC vs melee</div>
    <span class="stat-value derived">{{system.attributes.ac.vsMelee}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">AC vs ranged</div>
    <span class="stat-value derived">{{system.attributes.ac.vsRanged}}</span>
  </div>
  {{/if}}
</div>

{{#if system.attributes.conditionNotes.length}}
<div class="mb-md">
  {{#each system.attributes.conditionNotes}}
  <p class="notes">{{this}}</p>
  {{/each}}
</div>
{{/if}}
{{#each system.attributes.typeNotes}}
<p class="notes">{{this}}</p>
{{/each}}
{{#each system.attributes.featNotes}}
<p class="notes">{{this}}</p>
{{/each}}
{{#each system.attributes.round.notes}}
<p class="notes">{{this}}</p>
{{/each}}

<h3>This round</h3>
<div class="flexrow" style="gap:8px; flex-wrap:wrap;">
  <div class="form-group">
    <label>Posture</label>
    <select name="system.attributes.combat.posture">
      <option value="normal" {{#if (cts-eq system.attributes.combat.posture "normal")}}selected{{/if}}>Normal</option>
      <option value="fightingDefensively" {{#if (cts-eq system.attributes.combat.posture "fightingDefensively")}}selected{{/if}}>Fighting defensively</option>
      <option value="totalDefense" {{#if (cts-eq system.attributes.combat.posture "totalDefense")}}selected{{/if}}>Total defense</option>
      <option value="charge" {{#if (cts-eq system.attributes.combat.posture "charge")}}selected{{/if}}>Charge</option>
    </select>
  </div>
  <div class="form-group">
    <label>Flanking</label>
    <select name="system.attributes.combat.flanking">
      <option value="false" {{#unless (cts-eq system.attributes.combat.flanking "true")}}selected{{/unless}}>No</option>
      <option value="true" {{#if (cts-eq system.attributes.combat.flanking "true")}}selected{{/if}}>Yes (+2 melee)</option>
    </select>
  </div>
  <div class="form-group">
    <label>Higher ground</label>
    <select name="system.attributes.combat.higherGround">
      <option value="false" {{#unless (cts-eq system.attributes.combat.higherGround "true")}}selected{{/unless}}>No</option>
      <option value="true" {{#if (cts-eq system.attributes.combat.higherGround "true")}}selected{{/if}}>Yes (+2 melee)</option>
    </select>
  </div>
  <div class="form-group">
    <label>Point blank</label>
    <select name="system.attributes.combat.pointBlank">
      <option value="false" {{#unless (cts-eq system.attributes.combat.pointBlank "true")}}selected{{/unless}}>No</option>
      <option value="true" {{#if (cts-eq system.attributes.combat.pointBlank "true")}}selected{{/if}}>Yes (+1 ranged)</option>
    </select>
  </div>
  <div class="form-group">
    <label>Rapid Shot</label>
    <select name="system.attributes.combat.rapidShot">
      <option value="false" {{#unless (cts-eq system.attributes.combat.rapidShot "true")}}selected{{/unless}}>Off</option>
      <option value="true" {{#if (cts-eq system.attributes.combat.rapidShot "true")}}selected{{/if}}>On</option>
    </select>
  </div>
  <div class="form-group">
    <label>Sneak attack</label>
    <select name="system.attributes.combat.sneakAttack" title="Adds rogue sneak attack dice. Ranged sneak attack also needs Point blank.">
      <option value="false" {{#unless system.attributes.combat.sneakAttack}}selected{{/unless}}>Off</option>
      <option value="true" {{#if system.attributes.combat.sneakAttack}}selected{{/if}}>On</option>
    </select>
  </div>
  <div class="form-group">
    <label>Manyshot</label>
    <select name="system.attributes.combat.manyshot" title="Needs the Manyshot feat. Extra arrows are noted on the attack.">
      <option value="false" {{#unless system.attributes.combat.manyshot}}selected{{/unless}}>Off</option>
      <option value="true" {{#if system.attributes.combat.manyshot}}selected{{/if}}>On</option>
    </select>
  </div>
  <div class="form-group">
    <label>Distracted</label>
    <select name="system.attributes.combat.distracted" title="Threatened or distracted: cannot take 10">
      <option value="false" {{#unless system.attributes.combat.distracted}}selected{{/unless}}>No</option>
      <option value="true" {{#if system.attributes.combat.distracted}}selected{{/if}}>Yes</option>
    </select>
  </div>
  <div class="form-group">
    <label>Flurry</label>
    <select name="system.attributes.combat.flurry">
      <option value="false" {{#unless system.attributes.combat.flurry}}selected{{/unless}}>Off</option>
      <option value="true" {{#if system.attributes.combat.flurry}}selected{{/if}}>On</option>
    </select>
  </div>
  <div class="form-group">
    <label>Underwater</label>
    <select name="system.attributes.combat.underwater">
      <option value="false" {{#unless system.attributes.combat.underwater}}selected{{/unless}}>No</option>
      <option value="true" {{#if system.attributes.combat.underwater}}selected{{/if}}>Yes</option>
    </select>
  </div>
  <div class="form-group">
    <label>Shield spell</label>
    <select name="system.attributes.combat.shieldSpell">
      <option value="false" {{#unless system.attributes.combat.shieldSpell}}selected{{/unless}}>Off</option>
      <option value="true" {{#if system.attributes.combat.shieldSpell}}selected{{/if}}>+4 shield</option>
    </select>
  </div>
  <div class="form-group">
    <label>Delay</label>
    <select name="system.attributes.combat.delayed">
      <option value="false" {{#unless system.attributes.combat.delayed}}selected{{/unless}}>No</option>
      <option value="true" {{#if system.attributes.combat.delayed}}selected{{/if}}>Holding turn</option>
    </select>
  </div>
  <div class="form-group">
    <label>Ready</label>
    <select name="system.attributes.combat.readied">
      <option value="false" {{#unless system.attributes.combat.readied}}selected{{/unless}}>No</option>
      <option value="true" {{#if system.attributes.combat.readied}}selected{{/if}}>Readied</option>
    </select>
  </div>
  <div class="form-group">
    <label>Teleported</label>
    <select name="system.attributes.combat.teleported" title="Teleport and dimension door do not provoke.">
      <option value="false" {{#unless system.attributes.combat.teleported}}selected{{/unless}}>No</option>
      <option value="true" {{#if system.attributes.combat.teleported}}selected{{/if}}>No attack of opportunity</option>
    </select>
  </div>
  <div class="form-group">
    <label>Flat-footed</label>
    <select name="system.attributes.combat.flatFooted">
      <option value="false" {{#unless system.attributes.combat.flatFooted}}selected{{/unless}}>No</option>
      <option value="true" {{#if system.attributes.combat.flatFooted}}selected{{/if}}>Lose Dex</option>
    </select>
  </div>
  <div class="form-group">
    <label>Concealment %</label>
    <input type="number" name="system.attributes.combat.concealment" value="{{system.attributes.combat.concealment}}" min="0" max="100" step="1" title="20 or 50. The attack chat rolls 1d100." />
  </div>
  <div class="form-group">
    <label>Cast defensively</label>
    <select name="system.attributes.combat.castDefensively">
      <option value="false" {{#unless (cts-eq system.attributes.combat.castDefensively "true")}}selected{{/unless}}>No</option>
      <option value="true" {{#if (cts-eq system.attributes.combat.castDefensively "true")}}selected{{/if}}>Yes</option>
    </select>
  </div>
</div>
<div class="flexrow" style="gap:8px; flex-wrap:wrap;">
  <div class="form-group">
    <label>Power Attack</label>
    <input type="number" name="system.attributes.combat.powerAttack" value="{{system.attributes.combat.powerAttack}}" min="0" step="1" title="Needs the Power Attack feat. Capped at BAB." />
  </div>
  <div class="form-group">
    <label>Combat Expertise</label>
    <input type="number" name="system.attributes.combat.combatExpertise" value="{{system.attributes.combat.combatExpertise}}" min="0" step="1" title="Needs Combat Expertise. Capped at 5 or BAB." />
  </div>
  <div class="form-group">
    <label>Your cover</label>
    <select name="system.attributes.combat.coverSelf">
      <option value="none" {{#if (cts-eq system.attributes.combat.coverSelf "none")}}selected{{/if}}>None</option>
      <option value="partial" {{#if (cts-eq system.attributes.combat.coverSelf "partial")}}selected{{/if}}>Cover +4 AC</option>
      <option value="improved" {{#if (cts-eq system.attributes.combat.coverSelf "improved")}}selected{{/if}}>Improved +8 AC</option>
    </select>
  </div>
  <div class="form-group">
    <label>Target cover</label>
    <select name="system.attributes.combat.coverTarget">
      <option value="none" {{#if (cts-eq system.attributes.combat.coverTarget "none")}}selected{{/if}}>None</option>
      <option value="cover" {{#if (cts-eq system.attributes.combat.coverTarget "cover")}}selected{{/if}}>Cover −4</option>
      <option value="improved" {{#if (cts-eq system.attributes.combat.coverTarget "improved")}}selected{{/if}}>Improved −8</option>
    </select>
  </div>
</div>
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">AoOs</div>
    <span class="stat-value derived">{{system.attributes.aoo.remaining}} / {{system.attributes.aoo.pool}}</span>
  </div>
  <div class="stat-box">
    <button type="button" class="cts-btn secondary cts-aoo-spend">Spend</button>
    <button type="button" class="cts-btn secondary cts-aoo-reset">Reset</button>
  </div>
  <div class="stat-box">
    <div class="stat-label">Turning</div>
    <span class="stat-value derived" title="Cleric level, or paladin as a cleric three levels lower">{{system.attributes.turning.remaining}} / {{system.attributes.turning.pool}}</span>
  </div>
  <div class="stat-box">
    <button type="button" class="cts-btn secondary cts-turn-undead">Turn</button>
  </div>
  <div class="stat-box">
    <div class="stat-label">Conc. DC</div>
    <input type="number" name="system.attributes.combat.concentrationDc" value="{{system.attributes.combat.concentrationDc}}" step="1" />
  </div>
  <div class="stat-box">
    <button type="button" class="cts-btn secondary cts-concentration">Concentrate</button>
  </div>
</div>
<div class="mb-md">
  <button type="button" class="cts-btn secondary cts-maneuver" data-maneuver="trip">Trip</button>
  <button type="button" class="cts-btn secondary cts-maneuver" data-maneuver="disarm">Disarm</button>
  <button type="button" class="cts-btn secondary cts-maneuver" data-maneuver="bullrush">Bull rush</button>
  <button type="button" class="cts-btn secondary cts-maneuver" data-maneuver="sunder">Sunder</button>
  <button type="button" class="cts-btn secondary cts-apply-senses">Apply senses to token</button>
</div>

<div class="combat-stats mb-md cts-encumbrance-summary" title="Carrying capacity vs armor (world setting encumbrance automation)">
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncCarriedWeight"}}</div>
    <span class="stat-value derived">{{system.attributes.encumbrance.weightLb}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncLoadBand"}}</div>
    <span class="stat-value derived">{{system.attributes.encumbrance.weightBand}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncSpeedTier"}}</div>
    <span class="stat-value derived">{{system.attributes.encumbrance.speedTier}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncEffectiveACP"}}</div>
    <span class="stat-value derived">−{{system.attributes.encumbrance.effectiveCheckPenaltyMag}}</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">{{localize "CTSDND35.EncASF"}}</div>
    <span class="stat-value derived">{{system.spellcasting.arcaneSpellFailureTotal}}%</span>
  </div>
</div>

{{!-- BAB / Grapple / Init / SR --}}
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">BAB</div>
    <div class="stat-value derived" title="Negative levels apply −1 per level on attacks">{{cts-sign system.attributes.bab.total}}{{#if system.attributes.bab.attackPenalty}} <small>(−{{system.attributes.bab.attackPenalty}} atk)</small>{{/if}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Grapple</div>
    <div class="stat-value derived">{{cts-sign system.attributes.grapple.total}}</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Init</div>
    <div class="stat-value derived rollable init-roll" title="Roll Initiative">
      {{cts-sign system.attributes.init.total}}
    </div>
  </div>
  <div class="stat-box">
    <div class="stat-label">SR</div>
    <input type="number" name="system.attributes.sr.value" value="{{system.attributes.sr.value}}" />
  </div>
</div>

{{!-- Saving Throws --}}
<div class="saving-throws mb-md">
  {{#each system.attributes.savingThrows as |save key|}}
  <div class="save">
    <span class="save-label">{{key}}</span>
    <span class="save-total rollable save-roll" data-save="{{key}}" title="Roll {{key}} save">
      {{cts-sign save.total}}
    </span>
    {{#if save.baseFromClasses}}
    <span class="stat-value derived" style="width:36px;text-align:center;" title="Base save from class progression">{{save.classBase}}</span>
    {{else}}
    <input type="number" name="system.attributes.savingThrows.{{key}}.base" value="{{save.base}}" style="width:36px;text-align:center;" title="Base Save" />
    {{/if}}
    <input type="number" name="system.attributes.savingThrows.{{key}}.bonus" value="{{save.bonus}}" style="width:36px;text-align:center;" title="Misc Bonus" />
  </div>
  {{/each}}
</div>

{{!-- Speed --}}
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">Land base</div>
    <input type="number" name="system.attributes.speed.land.base" value="{{system.attributes.speed.land.base}}" /> ft
  </div>
  <div class="stat-box">
    <div class="stat-label">Land total</div>
    <span class="stat-value derived" title="After armor speed penalty, encumbrance, difficult terrain">{{system.attributes.speed.land.total}} ft</span>
  </div>
  {{#if system.attributes.speed.land.armorPenaltyFt}}
  <div class="stat-box">
    <div class="stat-label">Armor spd −</div>
    <span class="stat-value derived">{{system.attributes.speed.land.armorPenaltyFt}} ft</span>
  </div>
  {{/if}}
  <div class="stat-box">
    <div class="stat-label">Reach</div>
    <span class="stat-value derived" title="Default by size; override on Identity if needed">{{system.traits.reachFt}} ft</span>
  </div>
  <div class="stat-box">
    <div class="stat-label">Reach ovrd</div>
    <input type="number" name="system.traits.reachOverride" value="{{system.traits.reachOverride}}" placeholder="auto" title="Blank = size default" style="width:52px;" /> ft
  </div>
  <div class="stat-box">
    <label class="stat-label">Encumbrance</label>
    <select name="system.traits.encumbrance">
      <option value="none" {{#if (cts-eq system.traits.encumbrance "none")}}selected{{/if}}>None</option>
      <option value="medium" {{#if (cts-eq system.traits.encumbrance "medium")}}selected{{/if}}>Medium</option>
      <option value="heavy" {{#if (cts-eq system.traits.encumbrance "heavy")}}selected{{/if}}>Heavy</option>
      <option value="overload" {{#if (cts-eq system.traits.encumbrance "overload")}}selected{{/if}}>Overload</option>
    </select>
  </div>
  <div class="stat-box">
    <label class="stat-label" title="Half speed again">Terrain</label>
    <select name="system.traits.difficultTerrain">
      <option value="false" {{#unless system.traits.difficultTerrain}}selected{{/unless}}>Normal</option>
      <option value="true" {{#if system.traits.difficultTerrain}}selected{{/if}}>Difficult (−½)</option>
    </select>
  </div>
  <div class="stat-box">
    <div class="stat-label">Fly</div>
    <input type="number" name="system.attributes.speed.fly.base" value="{{system.attributes.speed.fly.base}}" /> ft
  </div>
  <div class="stat-box">
    <div class="stat-label">Swim</div>
    <input type="number" name="system.attributes.speed.swim.base" value="{{system.attributes.speed.swim.base}}" /> ft
  </div>
  <div class="stat-box">
    <div class="stat-label">Climb</div>
    <input type="number" name="system.attributes.speed.climb.base" value="{{system.attributes.speed.climb.base}}" /> ft
  </div>
</div>

<h3>Damage reduction</h3>
{{#each system.attributes.dr}}
<div class="flexrow cts-dr-row" data-index="{{@index}}">
  <input type="number" name="system.attributes.dr.{{@index}}.amount" value="{{this.amount}}" min="0" step="1" title="DR amount" style="width:64px;" />
  <input type="text" name="system.attributes.dr.{{@index}}.bypass" value="{{this.bypass}}" placeholder="magic, silver, adamantine…" class="flex-grow" />
  <button type="button" class="cts-icon-btn cts-remove-dr" data-index="{{@index}}" title="Remove"><i class="fas fa-trash"></i></button>
</div>
{{else}}
<p class="notes">No damage reduction.</p>
{{/each}}
<button type="button" class="cts-btn secondary cts-add-dr"><i class="fas fa-plus"></i> Add DR</button>

<h3>Energy resistance</h3>
<div class="combat-stats mb-md">
  <div class="stat-box">
    <div class="stat-label">Fire</div>
    <input type="number" name="system.attributes.energy.resist.fire" value="{{system.attributes.energy.resist.fire}}" min="0" step="1" />
    <label class="notes"><input type="checkbox" data-energy-immune="fire" {{#if system.attributes.energy.immune.fire}}checked{{/if}} /> Immune</label>
    <label class="notes"><input type="checkbox" data-energy-vulnerable="fire" {{#if system.attributes.energy.vulnerable.fire}}checked{{/if}} /> Vulnerable</label>
  </div>
  <div class="stat-box">
    <div class="stat-label">Cold</div>
    <input type="number" name="system.attributes.energy.resist.cold" value="{{system.attributes.energy.resist.cold}}" min="0" step="1" />
    <label class="notes"><input type="checkbox" data-energy-immune="cold" {{#if system.attributes.energy.immune.cold}}checked{{/if}} /> Immune</label>
    <label class="notes"><input type="checkbox" data-energy-vulnerable="cold" {{#if system.attributes.energy.vulnerable.cold}}checked{{/if}} /> Vulnerable</label>
  </div>
  <div class="stat-box">
    <div class="stat-label">Acid</div>
    <input type="number" name="system.attributes.energy.resist.acid" value="{{system.attributes.energy.resist.acid}}" min="0" step="1" />
    <label class="notes"><input type="checkbox" data-energy-immune="acid" {{#if system.attributes.energy.immune.acid}}checked{{/if}} /> Immune</label>
    <label class="notes"><input type="checkbox" data-energy-vulnerable="acid" {{#if system.attributes.energy.vulnerable.acid}}checked{{/if}} /> Vulnerable</label>
  </div>
  <div class="stat-box">
    <div class="stat-label">Electricity</div>
    <input type="number" name="system.attributes.energy.resist.electricity" value="{{system.attributes.energy.resist.electricity}}" min="0" step="1" />
    <label class="notes"><input type="checkbox" data-energy-immune="electricity" {{#if system.attributes.energy.immune.electricity}}checked{{/if}} /> Immune</label>
    <label class="notes"><input type="checkbox" data-energy-vulnerable="electricity" {{#if system.attributes.energy.vulnerable.electricity}}checked{{/if}} /> Vulnerable</label>
  </div>
  <div class="stat-box">
    <div class="stat-label">Sonic</div>
    <input type="number" name="system.attributes.energy.resist.sonic" value="{{system.attributes.energy.resist.sonic}}" min="0" step="1" />
    <label class="notes"><input type="checkbox" data-energy-immune="sonic" {{#if system.attributes.energy.immune.sonic}}checked{{/if}} /> Immune</label>
    <label class="notes"><input type="checkbox" data-energy-vulnerable="sonic" {{#if system.attributes.energy.vulnerable.sonic}}checked{{/if}} /> Vulnerable</label>
  </div>
</div>

{{!-- Attacks --}}
{{#if items.attacks.length}}
<h3>Attacks</h3>
<ol class="item-list">
  <li class="item-header">
    <span class="flex-grow">Name</span>
    <span style="width:80px;text-align:center;">Type</span>
    <span style="width:60px;text-align:center;">Controls</span>
  </li>
  {{#each items.attacks}}
  <li class="item" data-item-id="{{this._id}}">
    <img class="item-img" src="{{this.img}}" />
    <span class="item-name item-roll flex-grow">{{this.name}}</span>
    <span style="width:90px;text-align:center;" title="{{this.system.derived.damageFormula}}">{{this.system.derived.attackLabel}}</span>
    <div class="item-controls" style="width:60px;text-align:center;">
      <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
      <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
    </div>
  </li>
  {{/each}}
</ol>
{{/if}}

<h3>Typed saves</h3>
<p class="notes">Each bonus type is one number, so two morale bonuses do not stack. Circumstance is the amount you already added together. Dodge and circumstance are the types that stack.</p>
<div class="flexrow" style="gap:8px; flex-wrap:wrap;">
  {{#each system.attributes.savingThrows as |save key|}}
  <div class="form-group">
    <label>{{key}} circumstance</label>
    <input type="number" name="system.attributes.savingThrows.{{key}}.circumstance" value="{{save.circumstance}}" step="1" />
  </div>
  <div class="form-group">
    <label>{{key}} morale</label>
    <input type="number" name="system.attributes.savingThrows.{{key}}.morale" value="{{save.morale}}" step="1" />
  </div>
  <div class="form-group">
    <label>{{key}} resistance</label>
    <input type="number" name="system.attributes.savingThrows.{{key}}.resistance" value="{{save.resistance}}" step="1" />
  </div>
  {{/each}}
</div>

<h3>Rules</h3>
<p class="notes">Every remaining table procedure. The number is feet, DC, damage, CR, or gold, depending on the line you pick.</p>
<div class="flexrow" style="gap:8px; flex-wrap:wrap;">
  <select class="cts-procedure" style="min-width:240px;">
    {{#each procedures as |row|}}
    <option value="{{row.id}}">{{row.group}}: {{row.label}}</option>
    {{/each}}
  </select>
  <input type="number" class="cts-procedure-amount" value="0" step="1" />
  <button type="button" class="cts-btn secondary cts-procedure-run">Roll</button>
  <button type="button" class="cts-btn secondary cts-pp-spend">Spend power point</button>
  <button type="button" class="cts-btn secondary cts-pp-rest">Rest power points</button>
</div>
