<form class="cts-dnd-35 wizard" autocomplete="off" onsubmit="event.preventDefault();">
  <header class="wizard-header flexrow">
    <button type="button" class="step-indicator {{#if isStep1}}active{{/if}}" data-step="1">1. Basics</button>
    <button type="button" class="step-indicator {{#if isStep2}}active{{/if}}" data-step="2">2. Abilities</button>
    <button type="button" class="step-indicator {{#if isStep3}}active{{/if}}" data-step="3">3. Skills</button>
    <button type="button" class="step-indicator {{#if isStep4}}active{{/if}}" data-step="4">4. Feats</button>
  </header>

  <div class="wizard-content">
    {{#if isStep1}}
    <h3 style="margin-top:0;">Character Basics</h3>
    <div class="form-group">
      <label>Character Name</label>
      <input type="text" data-prop="basics.name" value="{{state.basics.name}}" />
    </div>
    <div class="form-group">
      <label>Race</label>
      <select data-prop="basics.race">
        {{#each config.races as |race key|}}
        <option value="{{key}}" {{#if (cts-eq key ../state.basics.race)}}selected{{/if}}>{{race.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Alignment</label>
      <select data-prop="basics.alignment">
        {{#each config.alignments as |label key|}}
        <option value="{{key}}" {{#if (cts-eq key ../state.basics.alignment)}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Deity</label>
      <input type="text" data-prop="basics.deity" value="{{state.basics.deity}}" placeholder="Optional" />
    </div>
    {{/if}}

    {{#if isStep2}}
    <h3 style="margin-top:0;">Ability Scores</h3>
    <div class="form-group">
      <label>Generation Method</label>
      <select data-prop="abilityMethod">
        <option value="array" {{#if (cts-eq state.abilityMethod "array")}}selected{{/if}}>Standard Array</option>
        <option value="pointbuy" {{#if (cts-eq state.abilityMethod "pointbuy")}}selected{{/if}}>Point Buy</option>
        <option value="roll" {{#if (cts-eq state.abilityMethod "roll")}}selected{{/if}}>Roll 4d6 drop lowest</option>
      </select>
    </div>

    {{#if (cts-eq state.abilityMethod "roll")}}
    <div class="flexrow mb-md">
      <button type="button" class="roll-stats cts-btn"><i class="fas fa-dice"></i> Roll Abilities</button>
    </div>
    {{/if}}

    <div style="max-height: 280px; overflow-y: auto;">
      {{#each config.abilityAbbreviations as |abbr key|}}
      <div class="form-group">
        <label>{{abbr}}</label>
        <input type="number" data-prop="abilities.{{key}}" value="{{lookup ../state.abilities key}}" min="8" max="18" />
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if isStep3}}
    <h3 style="margin-top:0;">Skills</h3>
    <div class="form-group">
      <label>Primary Class</label>
      <select data-prop="classes.primary">
        <option value="">-- Select class --</option>
        {{#each classChoices as |c|}}
        <option value="{{c.uuid}}" {{#if (cts-eq c.uuid ../state.classes.primary)}}selected{{/if}}>{{c.name}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Primary Class Level</label>
      <input type="number" data-prop="classLevels.primary" value="{{state.classLevels.primary}}" min="1" />
    </div>
    {{#if allowGestalt}}
    <div class="form-group">
      <label>Secondary Class (optional)</label>
      <select data-prop="classes.secondary">
        <option value="">-- None --</option>
        {{#each classChoices as |c|}}
        <option value="{{c.uuid}}" {{#if (cts-eq c.uuid ../state.classes.secondary)}}selected{{/if}}>{{c.name}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Secondary Class Level</label>
      <input type="number" data-prop="classLevels.secondary" value="{{state.classLevels.secondary}}" min="0" />
    </div>
    {{/if}}

    <p class="notes">
      {{primaryClassLabel}} points: <strong>{{skillBudget.primaryRemaining}}</strong> / {{skillBudget.primary}}
      {{#if allowGestalt}}
      &nbsp; | &nbsp;
      {{secondaryClassLabel}} points: <strong>{{skillBudget.secondaryRemaining}}</strong> / {{skillBudget.secondary}}
      {{/if}}
    </p>
    {{#if primaryFeaturePreview.length}}
    <p class="notes" style="margin-bottom:4px;"><strong>{{primaryClassLabel}} feature grants</strong></p>
    <ul style="max-height:80px; overflow-y:auto; margin-top:0;">
      {{#each primaryFeaturePreview as |feat|}}
      <li>{{feat.name}}</li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if allowGestalt}}
      {{#if secondaryFeaturePreview.length}}
      <p class="notes" style="margin-bottom:4px;"><strong>{{secondaryClassLabel}} feature grants</strong></p>
      <ul style="max-height:80px; overflow-y:auto; margin-top:0;">
        {{#each secondaryFeaturePreview as |feat|}}
        <li>{{feat.name}}</li>
        {{/each}}
      </ul>
      {{/if}}
    {{/if}}

    <div style="max-height: 300px; overflow-y: auto; border: 1px solid var(--cts-border-dark); padding: 6px;">
      <div class="flexrow" style="font-weight: bold; margin-bottom: 6px;">
        <div style="flex: 2;">Skill</div>
        <div style="flex: 1; text-align:center;">Total</div>
        <div style="flex: 1; text-align:center;">{{primaryClassLabel}}</div>
        {{#if allowGestalt}}<div style="flex: 1; text-align:center;">{{secondaryClassLabel}}</div>{{/if}}
        <div style="flex: 0.7; text-align:center;">Ability</div>
      </div>
      {{#each skillRows as |row|}}
      <div class="flexrow" style="align-items: center; margin-bottom: 4px;">
        <div style="flex: 2;">{{row.label}}</div>
        <div style="flex: 1; text-align:center; font-weight:bold;">{{row.total}}</div>
        <div style="flex: 1; text-align:center;">
          <button type="button" class="skill-dec" data-which="primary" data-skill="{{row.key}}">-</button>
          <span style="display:inline-block; min-width: 20px;">{{row.primaryRanks}}</span>
          <button type="button" class="skill-inc" data-which="primary" data-skill="{{row.key}}">+</button>
        </div>
        {{#if ../allowGestalt}}
        <div style="flex: 1; text-align:center;">
          <button type="button" class="skill-dec" data-which="secondary" data-skill="{{row.key}}">-</button>
          <span style="display:inline-block; min-width: 20px;">{{row.secondaryRanks}}</span>
          <button type="button" class="skill-inc" data-which="secondary" data-skill="{{row.key}}">+</button>
        </div>
        {{/if}}
        <div style="flex: 0.7; text-align:center;">{{row.ability}}</div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if isStep4}}
    <h3 style="margin-top:0;">Feats</h3>
    <p class="notes">
      {{#if featsRemaining}}Choose feats.{{else}}No more feats may be added.{{/if}}
      Remaining: <strong>{{featsRemaining}}</strong> / {{featSlots}}
    </p>
    <div class="flexrow" style="gap:8px;">
      <div style="flex: 1;">
        <div class="form-group">
          <label>Search</label>
          <input type="text" data-prop="featSearch" value="{{state.featSearch}}" placeholder="Type here to search" />
        </div>
        <div class="form-group">
          <label>Type</label>
          <select data-prop="featTypeFilter">
            <option value="all" {{#if (cts-eq state.featTypeFilter "all")}}selected{{/if}}>Everything</option>
            {{#each featTypes as |type|}}
            <option value="{{type}}" {{#if (cts-eq type ../state.featTypeFilter)}}selected{{/if}}>{{type}}</option>
            {{/each}}
          </select>
        </div>
        <div style="max-height: 240px; overflow-y: auto; border:1px solid var(--cts-border-dark);">
          {{#each featChoices as |feat|}}
          <div class="feat-choice" data-uuid="{{feat.uuid}}" style="padding:4px 6px; cursor:pointer; border-bottom:1px solid var(--cts-border-dark);">
            <strong>{{feat.name}}</strong>
            <span class="notes"> - {{feat.type}}</span>
            {{#unless feat.prereqOk}}
            <div class="notes" style="color:#c94c4c;">Prereq not met: {{feat.prereqReason}}</div>
            {{/unless}}
          </div>
          {{/each}}
        </div>
      </div>
      <div style="flex: 1;">
        <h4 style="margin:0 0 6px 0;">{{#if activeFeat}}{{activeFeat.name}}{{else}}Select a feat{{/if}}</h4>
        <div style="max-height: 180px; overflow-y:auto; border:1px solid var(--cts-border-dark); padding:6px;">
          {{{activeFeat.description}}}
          {{#if activeFeat.prereqReason}}
          <hr />
          <p class="notes" style="color:#c94c4c; margin:0;">{{activeFeat.prereqReason}}</p>
          {{/if}}
        </div>
        <div style="margin-top:8px;">
          <button type="button" class="cts-btn add-feat">Add</button>
        </div>
        <div style="margin-top:8px;">
          <strong>Selected:</strong>
          {{#if selectedFeats.length}}
            {{#each selectedFeats as |feat|}}
            <div class="flexrow" style="align-items:center; margin-top:4px;">
              <span style="flex:1;">{{feat.name}}</span>
              <button type="button" class="remove-feat" data-uuid="{{feat.uuid}}">Remove</button>
            </div>
            {{/each}}
          {{else}}
            <div class="notes">No feats selected yet.</div>
          {{/if}}
        </div>
      </div>
    </div>
    <hr />
    <h4 style="margin:8px 0 6px 0;">Starting Spells</h4>
    {{#if isSpontaneousCaster}}
    <p class="notes">Known picks: <strong>{{spellPickCount}}</strong> / {{spellPickCap}}</p>
    {{/if}}
    {{#if isPreparedCaster}}
    <p class="notes">Prepared caster mode: spell picks are optional references (no strict known-spell cap).</p>
    {{/if}}
    {{#if isSpontaneousCaster}}
    <p class="notes" style="margin-top:2px;">
      {{#each spellPickCapsByLevel}}
        L{{@key}}: {{lookup ../spellPickCountByLevel @key}} / {{this}}&nbsp;
      {{/each}}
    </p>
    {{/if}}
    <div class="form-group">
      <label>Spell Search</label>
      <input type="text" data-prop="spellSearch" value="{{state.spellSearch}}" placeholder="Type here to search class spells" />
    </div>
    <div class="flexrow" style="gap:8px;">
      <div style="flex:1; max-height:190px; overflow-y:auto; border:1px solid var(--cts-border-dark);">
        {{#each availableSpells as |spell|}}
        <div class="spell-choice" data-uuid="{{spell.uuid}}" style="padding:4px 6px; cursor:pointer; border-bottom:1px solid var(--cts-border-dark);">
          <strong>{{spell.name}}</strong>
          <span class="notes"> ({{spell.spellLevel}})</span>
        </div>
        {{/each}}
      </div>
      <div style="flex:1; max-height:190px; overflow-y:auto; border:1px solid var(--cts-border-dark); padding:6px;">
        <strong>Selected Spells</strong>
        {{#if selectedSpells.length}}
          {{#each selectedSpells as |spell|}}
          <div class="flexrow" style="align-items:center; margin-top:4px;">
            <span style="flex:1;">{{spell.name}} ({{spell.spellLevel}})</span>
            <button type="button" class="remove-spell" data-uuid="{{spell.uuid}}">Remove</button>
          </div>
          {{/each}}
        {{else}}
        <p class="notes" style="margin:6px 0 0;">No spells selected.</p>
        {{/if}}
      </div>
    </div>
    {{/if}}
  </div>

  <footer class="wizard-footer flexrow" style="gap:8px; margin-top:16px; padding-top:16px; border-top:1px solid var(--cts-border-dark);">
    {{#if isStep4}}
    <button type="button" class="cts-btn apply-wizard" style="flex: 1;">Apply & Finish</button>
    {{else}}
    <p class="notes" style="margin:0; width: 100%; text-align: center;">Click the tabs above to move between steps.</p>
    {{/if}}
  </footer>
</form>
