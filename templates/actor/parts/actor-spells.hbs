{{!-- Spells Tab Partial --}}
{{#each items.spells as |spellList level|}}
<h3>Level {{level}}</h3>
<ol class="item-list mb-md">
  {{#each spellList}}
  <li class="item" data-item-id="{{this._id}}"><img class="item-img" src="{{this.img}}" /><span class="item-name item-roll flex-grow">{{this.name}}</span><span style="width:60px;">{{this.system.school}}</span><div class="item-controls"><a class="item-edit"><i class="fas fa-edit"></i></a><a class="item-delete"><i class="fas fa-trash"></i></a></div></li>
  {{/each}}
</ol>
{{/each}}
