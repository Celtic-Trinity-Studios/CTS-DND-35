<div class="cts-column cts-factions-column">
  <h3><i class="fas fa-flag"></i> Factions</h3>
  <p class="cts-faction-hint">Create <strong>Faction</strong> items from the Items sidebar (or a compendium), then drag them onto this actor. Double-click an entry or edit from the Items directory to change name / <strong>Gear %</strong> — the sheet updates automatically.</p>
  {{#each items.factions}}
  <div class="cts-line item" data-item-id="{{this._id}}">
    <span class="item-name item-roll">{{this.name}}</span>
    <span class="cts-faction-pct" title="Gear price % when this actor buys">{{#if this.system.gearPct}}{{this.system.gearPct}}{{else}}0{{/if}}%</span>
    <span class="cts-line-controls">
      <a class="item-delete" title="Remove from character"><i class="fas fa-trash"></i></a>
    </span>
  </div>
  {{/each}}
</div>
