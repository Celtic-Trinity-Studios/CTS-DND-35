<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="48" width="48" />
    <div class="header-fields">
      <input class="char-name flex-grow" name="name" type="text" value="{{item.name}}" />
      <span class="stat-label" style="text-transform:uppercase;">spell</span>
    </div>
  </header>
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description"><i class="fas fa-book"></i> Description</a>
    <a class="item" data-tab="details"><i class="fas fa-cog"></i> Details</a>
  </nav>
  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="description">
      <h3>Description</h3>
      {{editor enrichedDescription target="system.description" button=true editable=editable}}
    </div>
    <div class="tab" data-group="primary" data-tab="details">
      {{#if derived.dc}}
      <p class="notes">On the owning actor: DC <strong>{{derived.dc}}</strong>{{#if derived.className}} ({{derived.className}}, CL {{derived.casterLevel}}){{/if}}{{#if derived.failureChance}} · failure {{derived.failureChance}}%{{/if}}</p>
      {{/if}}
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Level</label>
          <input type="number" name="system.spellLevel" value="{{system.spellLevel}}" min="0" max="9" step="1" />
        </div>
        <div class="form-group flex-grow">
          <label>School</label>
          <input type="text" name="system.school" value="{{system.school}}" />
        </div>
      </div>
      <div class="form-group">
        <label>Caster class</label>
        <input type="text" name="system.casterClass" value="{{system.casterClass}}" placeholder="Wizard — blank uses the best match" />
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Save</label>
          <select name="system.save.ability">
            <option value="" {{#unless system.save.ability}}selected{{/unless}}>From description</option>
            <option value="fort" {{#if (cts-eq system.save.ability "fort")}}selected{{/if}}>Fortitude</option>
            <option value="ref" {{#if (cts-eq system.save.ability "ref")}}selected{{/if}}>Reflex</option>
            <option value="will" {{#if (cts-eq system.save.ability "will")}}selected{{/if}}>Will</option>
            <option value="none" {{#if (cts-eq system.save.ability "none")}}selected{{/if}}>None</option>
          </select>
        </div>
        <div class="form-group flex-grow">
          <label>DC override</label>
          <input type="number" name="system.save.dc" value="{{system.save.dc}}" placeholder="auto" />
        </div>
        <div class="form-group flex-grow">
          <label>Half on save</label>
          <select name="system.save.half">
            <option value="false" {{#unless system.save.half}}selected{{/unless}}>No</option>
            <option value="true" {{#if system.save.half}}selected{{/if}}>Yes</option>
          </select>
        </div>
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Casting time</label>
          <input type="text" name="system.castingTime" value="{{system.castingTime}}" />
        </div>
        <div class="form-group flex-grow">
          <label>Range</label>
          <input type="text" name="system.range.value" value="{{system.range.value}}" />
        </div>
      </div>
      <div class="form-group">
        <label>Prepared</label>
        <input type="number" name="system.prepared" value="{{system.prepared}}" min="0" step="1" title="For prepared casters. Casting spends one." />
      </div>
      <h4>Metamagic</h4>
      <div class="flexrow" style="gap:8px; flex-wrap:wrap;">
        <div class="form-group"><label>Heighten +levels</label><input type="number" name="system.metamagic.heighten" value="{{system.metamagic.heighten}}" min="0" step="1" /></div>
        <div class="form-group"><label>Empower</label><select name="system.metamagic.empower"><option value="false" {{#unless (cts-eq system.metamagic.empower "true")}}selected{{/unless}}>No</option><option value="true" {{#if (cts-eq system.metamagic.empower "true")}}selected{{/if}}>Yes (+2 slot)</option></select></div>
        <div class="form-group"><label>Extend</label><select name="system.metamagic.extend"><option value="false" {{#unless (cts-eq system.metamagic.extend "true")}}selected{{/unless}}>No</option><option value="true" {{#if (cts-eq system.metamagic.extend "true")}}selected{{/if}}>Yes (+1 slot)</option></select></div>
        <div class="form-group"><label>Still</label><select name="system.metamagic.still"><option value="false" {{#unless (cts-eq system.metamagic.still "true")}}selected{{/unless}}>No</option><option value="true" {{#if (cts-eq system.metamagic.still "true")}}selected{{/if}}>Yes (no ASF)</option></select></div>
        <div class="form-group"><label>Silent</label><select name="system.metamagic.silent"><option value="false" {{#unless (cts-eq system.metamagic.silent "true")}}selected{{/unless}}>No</option><option value="true" {{#if (cts-eq system.metamagic.silent "true")}}selected{{/if}}>Yes (no deafened fail)</option></select></div>
        <div class="form-group"><label>Quicken</label><select name="system.metamagic.quicken"><option value="false" {{#unless (cts-eq system.metamagic.quicken "true")}}selected{{/unless}}>No</option><option value="true" {{#if (cts-eq system.metamagic.quicken "true")}}selected{{/if}}>Yes (+4 slot)</option></select></div>
      </div>
      <p class="notes">Click the spell on the character to roll failure, defensive casting, and the spell resistance check. Prepared casters spend one preparation. Spontaneous casters spend a slot at the metamagic-adjusted level. DC is 10 + level (plus Heighten) + ability + Spell Focus.</p>
    </div>
  </section>
</form>
