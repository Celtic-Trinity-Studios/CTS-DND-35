<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="48" width="48" />
    <div class="header-fields">
      <input class="char-name flex-grow" name="name" type="text" value="{{item.name}}" />
      <span class="stat-label" style="text-transform:uppercase;">attack</span>
    </div>
  </header>
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description"><i class="fas fa-book"></i> Description</a>
    <a class="item" data-tab="details"><i class="fas fa-cog"></i> Details</a>
  </nav>
  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="description">
      <h3>Description</h3>
      {{editor enrichedDescription target="system.description" button=true editable=editable}}
    </div>
    <div class="tab" data-group="primary" data-tab="details">
      {{#if derived.attackLabel}}
      <p class="notes">On the owning actor: <strong>{{derived.attackLabel}}</strong> · {{derived.damageFormula}}</p>
      {{/if}}
      <div class="form-group">
        <label>Mode</label>
        <select name="system.weaponSubtype">
          <option value="melee" {{#if (cts-eq system.weaponSubtype "melee")}}selected{{/if}}>Melee</option>
          <option value="ranged" {{#if (cts-eq system.weaponSubtype "ranged")}}selected{{/if}}>Ranged</option>
          <option value="touch" {{#if (cts-eq system.weaponSubtype "touch")}}selected{{/if}}>Touch</option>
          <option value="rangedTouch" {{#if (cts-eq system.weaponSubtype "rangedTouch")}}selected{{/if}}>Ranged touch</option>
        </select>
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Damage</label>
          <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="1d8" />
        </div>
        <div class="form-group flex-grow">
          <label>Damage type</label>
          <input type="text" name="system.damageType" value="{{system.damageType}}" placeholder="fire" />
        </div>
      </div>
      <div class="flexrow" style="gap:8px;">
        <div class="form-group flex-grow">
          <label>Attack misc</label>
          <input type="number" name="system.attackMisc" value="{{system.attackMisc}}" step="1" />
        </div>
        <div class="form-group flex-grow">
          <label>Enhancement</label>
          <input type="number" name="system.enhancement" value="{{system.enhancement}}" step="1" />
        </div>
      </div>
      <p class="notes">Uses the same attack pipeline as weapons: BAB, ability, size, enhancement, and condition penalties. Click the name on the Combat tab to roll.</p>
    </div>
  </section>
</form>
